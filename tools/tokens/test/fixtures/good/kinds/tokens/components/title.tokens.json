{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "title": {
    "plate": {
      "$description": "The title plate.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyTitlePlate",
            "class": "Label",
            "base": {
              "any": "ToyBaseTitle"
            }
          },
          "context": "dark"
        }
      },
      "label": {
        "$type": "typography",
        "$value": "{type.hero}"
      },
      "normal": {
        "bg-color": {
          "$type": "color",
          "$value": "{palette.yellow}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{color.outline}"
        },
        "border-width": {
          "$type": "dimension",
          "$value": "{stroke.bold}"
        },
        "corner-radius": {
          "$type": "dimension",
          "$value": "{radius.large}"
        },
        "content-margin-block": {
          "$type": "dimension",
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "expand-margin-inline": {
          "$type": "dimension",
          "$value": {
            "value": 36,
            "unit": "px"
          }
        },
        "expand-margin-bottom": {
          "$type": "dimension",
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "font-color": {
          "$type": "color",
          "$value": "{color.outline}"
        }
      }
    },
    "base": {
      "$description": "The title base.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyBaseTitle",
            "class": "Panel"
          },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": {
          "$type": "color",
          "$value": "{color.on-dark.base}"
        },
        "corner-radius": {
          "$type": "dimension",
          "$value": "{radius.large}"
        },
        "expand-margin-top": {
          "$type": "dimension",
          "$value": {
            "value": -6,
            "unit": "px"
          }
        },
        "expand-margin-inline": {
          "$type": "dimension",
          "$value": {
            "value": 36,
            "unit": "px"
          }
        },
        "expand-margin-bottom": {
          "$type": "dimension",
          "$value": {
            "value": 14,
            "unit": "px"
          }
        }
      }
    }
  }
}
