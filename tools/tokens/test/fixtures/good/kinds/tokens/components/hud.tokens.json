{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "hud": {
    "spinner": {
      "$description": "A spinner ring with a gap.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToySpinner",
            "class": "Panel"
          },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": {
          "$type": "color",
          "$value": "{palette.clear}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{palette.yellow}"
        },
        "border-width-top": {
          "$type": "dimension",
          "$value": {
            "value": 10,
            "unit": "px"
          }
        },
        "border-width-right": {
          "$type": "dimension",
          "$value": {
            "value": 10,
            "unit": "px"
          }
        },
        "border-width-bottom": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "border-width-left": {
          "$type": "dimension",
          "$value": {
            "value": 10,
            "unit": "px"
          }
        },
        "corner-radius": {
          "$type": "dimension",
          "$value": "{radius.pill}"
        }
      },
      "size": {
        "$type": "dimension",
        "width": {
          "$value": {
            "value": 48,
            "unit": "px"
          }
        },
        "height": {
          "$value": {
            "value": 48,
            "unit": "px"
          }
        }
      }
    }
  }
}
