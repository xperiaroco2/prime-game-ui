      "children": [
        {
          "name": "Before", "type": "Label", "variation": "ToyTextOnDark", "key": "selftest.piece.both_sides", "piece": 0, "args": { "key": "E" },
          "per_state": { "end": { "key": "selftest.piece.at_end" }, "edges": { "key": "selftest.piece.edges" } }
        },
        {
