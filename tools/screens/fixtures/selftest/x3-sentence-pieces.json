              "per_state": { "end": { "key": "selftest.piece.at_end" }, "edges": { "key": "selftest.piece.edges" } }
            }
          ]
        },
        {
          "name": "After", "type": "Label", "variation": "ToyTextOnDark", "key": "selftest.piece.both_sides", "piece": 1, "args": { "key": "E" },
