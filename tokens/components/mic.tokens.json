{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "mic": {
    "$description": "The voice chat mic badge.",
    "plate": {
      "$description": "The mic badge: a round purple sticker (the coral off icon needs the dark face), 6 px ink outline; the icon is tinted mint (on) or coral (off). The hard shadow is the edge form: the right and bottom outlines are 14 px (6 + 8) and reach 8 px outside the badge.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMic", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.control}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 75, "unit": "px" } },
        "height": { "$value": { "value": 75, "unit": "px" } }
      },
      "items": {
        "icon-on": { "$type": "color", "$value": "{color.on-dark.text}" },
        "icon-off": { "$type": "color", "$value": "{color.status.alert}" }
      }
    }
  }
}
