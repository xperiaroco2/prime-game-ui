{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "mutation": {
    "$description": "The mutation workbench, a screen on the machine (a SubViewport): cards are module tiles.",
    "card": {
      "$description": "A mutation card (the target's .card): a module tile with the 2 px edge and 12 px corners; one you cannot afford keeps its look, its button unplugged.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMutationCard", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } }
      }
    },
    "balance": {
      "$description": "The points on the workbench: no plate (minimal), the number in the accent beside its word.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateBalance", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } }
      }
    }
  }
}
