{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "roster": {
    "$description": "The round HUD's roster (MVP, the engineer, 2026-10-20): every player's name and body colour in a slim purple list at the top right; a human sees the other humans tagged.",
    "panel": {
      "$description": "The roster: a purple sticker with the 6 px ink outline (the sketch's 10/12 px padding x 1.5 with its outline: 21 and 24 px), at least 285 px wide (190 x 1.5); its rows are ToyRowTwelve (a colour dot, the name, a tag) in a ToyColumnEight. The hard shadow is the edge form: the right and bottom outlines are 14 px (6 + 8) and reach 8 px outside, as no base layer sits under it in the game.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRoster", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": { "value": 285, "unit": "px" } }
      }
    },
    "name": {
      "$description": "A player's name in the roster: mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterName", "class": "Label", "on": ["ToyRoster"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "name-self": {
      "$description": "The player's own name in the roster: the alien green.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterNameSelf", "class": "Label", "on": ["ToyRoster"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{palette.green}" }
      }
    },
    "name-dead": {
      "$description": "A dead player's name in the roster: the dim lilac.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterNameDead", "class": "Label", "on": ["ToyRoster"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text-muted}" }
      }
    },
    "dot": {
      "$description": "A player's colour dot (in the roster and the kill notices): a white disc with a 5 px ink ring, 24 px (16 x 1.5); the game tints it to the body colour with self_modulate (the ink ring stays dark).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterDot", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 24, "unit": "px" } },
        "height": { "$value": { "value": 24, "unit": "px" } }
      }
    },
    "tag": {
      "$description": "The tag on another human in a human's roster: a small coral sticker, a 5 px ink outline, 12 px corners, no shadow.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterTag", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "tag-text": {
      "$description": "The word on the human tag: ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterTagText", "class": "Label", "on": ["ToyRosterTag"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    }
  }
}
