{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "roster": {
    "$description": "The roster (top right): a module tile listing the players with their body colours.",
    "panel": {
      "$description": "The roster (the target's top-right tile): the plain tile, at least 276 px wide (184 x 1.5), 18 px above and below, 21 px at the sides; rows in a ToyColumnEight.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRoster", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } }
      },
      "size": {
        "min-width": { "$type": "dimension", "$value": { "value": 276, "unit": "px" } }
      }
    },
    "name": {
      "$description": "A player's name: light, the caption size (the target's 12 px x 1.5).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterName", "class": "Label", "on": ["ToyRoster"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "name-self": {
      "$description": "The own name: the accent.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterNameSelf", "class": "Label", "on": ["ToyRoster"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{palette.accent}" }
      }
    },
    "name-dead": {
      "$description": "A dead player's name: dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterNameDead", "class": "Label", "on": ["ToyRoster"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text-muted}" }
      }
    },
    "dot": {
      "$description": "A player's colour: a 15 px square with 5 px corners (the target's 10 and 3 x 1.5), white, tinted to the body colour with self_modulate.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterDot", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } }
      }
    },
    "tag": {
      "$description": "The human tag in a human's roster (the target's .tg): the roster's own module fill, a 2 px danger outline, 5 px corners.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterTag", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      }
    },
    "tag-text": {
      "$description": "The human tag's word: Unbounded capitals in the danger colour (the game writes the word in capitals).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRosterTagText", "class": "Label", "on": ["ToyRosterTag"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.kicker}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.status.alert}" }
      }
    }
  }
}
