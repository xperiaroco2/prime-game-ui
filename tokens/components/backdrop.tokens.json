{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "backdrop": {
    "$description": "Full-screen backdrops behind menus and dialogs: the deep purple ground, see-through over the world or solid.",
    "dim": {
      "$description": "The dim backdrop: the deep purple at 82 % over the world.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBackdrop", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.backdrop}" }
      }
    },
    "deep": {
      "$description": "The deeper backdrop: the deep purple at 86 % over the world.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBackdropDeep", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.backdrop-deep}" }
      }
    },
    "night": {
      "$description": "The opaque night backdrop: the solid deep purple ground.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBackdropNight", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.night}" }
      }
    }
  }
}
