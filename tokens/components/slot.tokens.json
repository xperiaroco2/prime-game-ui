{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "slot": {
    "$description": "The hand and belt (the target's slots): module tiles with the item's line picture and its name inside; the hand in use has a 3 px accent outline.",
    "idle": {
      "$description": "An item slot: the plain tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySlot", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 132, "unit": "px" } },
        "height": { "$value": { "value": 132, "unit": "px" } },
        "wide-width": { "$value": { "value": 270, "unit": "px" } }
      }
    },
    "active": {
      "$description": "The active slot: the tile with a 3 px accent outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySlotActive", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.selected}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 132, "unit": "px" } },
        "height": { "$value": { "value": 132, "unit": "px" } },
        "wide-width": { "$value": { "value": 270, "unit": "px" } }
      }
    },
    "text": {
      "$description": "An item's name in a slot: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySlotText", "class": "Label", "on": ["ToySlot", "ToySlotActive"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "text-empty": {
      "$description": "An empty slot's word: dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySlotTextEmpty", "class": "Label", "on": ["ToySlot", "ToySlotActive"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "hand": {
      "$description": "The hand (the target's .sl.on): a 117 x 132 module tile (78 x 88 x 1.5) with a 3 px accent outline; the item's line picture tinted the accent, since ui-2.1.0 the head (ToyKicker, hud.slot.hand) at the top, the picture (57 px) in the centre and the name under it, all inside, 6 px above and below (so a large-text name still fits the 132 px) and 12 at the sides.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySlotHand", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.selected}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 117, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 132, "unit": "px" } }
      }
    },
    "belt": {
      "$description": "The belt: a 117 x 132 module tile with the 2 px edge; the picture and the name light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySlotBelt", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 117, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 132, "unit": "px" } }
      }
    },
    "tag": {
      "$description": "A slot's name: no plate since ui-2.0.0 (the name sits inside the tile, at its bottom).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySlotTag", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 17, "unit": "px" } }
      }
    },
    "tag-text": {
      "$description": "A slot's name, inside the tile at its bottom since ui-2.0.0: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToySlotTagText",
            "class": "Label",
            "on": ["ToySlotTag", "ToySlotHand", "ToySlotBelt", "ToySlot"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    }
  }
}
