{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sticker": {
    "$description": "Word tiles (the reason line of the ends, the human's team line): module tiles; the loud ones have a 3 px accent or danger outline.",
    "mint": {
      "$description": "A word tile: the module fill with the 2 px edge, 9 px corners.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySticker", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } }
      }
    },
    "alert": {
      "$description": "A danger word tile: the module fill with a 3 px danger outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyStickerAlert", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.selected}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } }
      }
    },
    "highlight": {
      "$description": "A highlighted word tile: the module fill with a 3 px accent outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyStickerHighlight", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.selected}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } }
      }
    },
    "text": {
      "$description": "A word tile's text: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyStickerText",
            "class": "Label",
            "on": ["ToySticker", "ToyStickerAlert", "ToyStickerHighlight"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "text-large": {
      "$description": "A word tile's text on the full screens: light, heading-bold.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyStickerTextLarge",
            "class": "Label",
            "on": ["ToySticker", "ToyStickerAlert", "ToyStickerHighlight"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.heading-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    }
  }
}
