{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "bar": {
    "$description": "Bars: the HUD bars (since ui-1.3.0 one ProgressBar each, calm and alarm; the older track with a fill-only bar inside is deprecated), task progress, the slider track, the slider and the scroll bar.",
    "track": {
      "$description": "The HUD bar track until ui-1.2.0: the base with fully round ends since ui-2.0.0 (deprecated since ui-1.3.0).",
      "$deprecated": "The HUD bars are one ProgressBar each since ui-1.3.0 (ToyBarHealthCalm, ToyBarStaminaCalm): its own background is the track. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarTrack", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "height": { "$value": { "value": 24, "unit": "px" } }
      }
    },
    "stamina": {
      "$description": "The stamina fill until ui-1.2.0: the light text colour with round ends since ui-2.0.0 (deprecated since ui-1.3.0).",
      "$deprecated": "ui-1.3.0 (replaced by the …Calm bar, itself deprecated since ui-2.0.0: health and stamina are pips, ToyPip…). Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarStamina", "class": "ProgressBar", "on": ["ToyBarTrack"] },
          "context": "dark"
        }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.stamina}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 7, "unit": "px" } },
        "content-margin-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "health": {
      "$description": "The health fill until ui-1.2.0: white, tinted by the nearest of 21 ramp stops (the danger colour to the accent) at draw time (deprecated since ui-1.3.0).",
      "$deprecated": "ui-1.3.0 (replaced by the …Calm bar, itself deprecated since ui-2.0.0: health and stamina are pips, ToyPip…). Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarHealth", "class": "ProgressBar", "on": ["ToyBarTrack"] },
          "context": "dark"
        }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 7, "unit": "px" } },
        "content-margin-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "ramp": {
        "full": { "$type": "color", "$value": "{color.status.health-full}" },
        "empty": { "$type": "color", "$value": "{color.status.health-empty}" },
        "steps": { "$type": "number", "$value": 20 }
      }
    },
    "progress": {
      "$description": "A thin progress bar (the raising bar under the crosshair, loading): the base track, the accent fill, fully round ends, no outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarProgress", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.progress}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      }
    },
    "slider": {
      "$description": "A setting's bar beside its slider: the base track and the accent fill, fully round ends.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarSlider", "class": "ProgressBar" },
          "context": "light"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.progress}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      }
    },
    "label": {
      "$description": "A bar's caption plate: a small module tile with no edge.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarLabel", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      }
    },
    "slider-control": {
      "$description": "A setting slider (the target's .sld): a 12 px base track with 6 px corners, the accent fill to the knob, the knob a 21 x 33 light tile (icons/slider-knob.svg, its own colours); focus an accent ring 3 px outside (the game draws it: Godot's Slider has no focus StyleBox).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToySlider",
            "class": "HSlider",
            "textures": {
              "grabber": "icons/slider-knob.svg",
              "grabber-highlight": "icons/slider-knob.svg",
              "grabber-disabled": "icons/slider-knob-disabled.svg"
            }
          },
          "context": "light"
        }
      },
      "slider": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "grabber-area": {
        "bg-color": { "$type": "color", "$value": "{color.status.progress}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" }
      },
      "grabber-area-highlight": {
        "bg-color": { "$type": "color", "$value": "{color.status.progress}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      }
    },
    "scroll": {
      "$description": "A list's scroll bar: the base track and a dim grabber, light while hovered or held.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyScrollBar", "class": "VScrollBar" },
          "context": "light"
        }
      },
      "scroll": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "grabber": {
        "bg-color": { "$type": "color", "$value": "{color.on-light.text-muted}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "grabber-highlight": {
        "bg-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "grabber-pressed": {
        "bg-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      }
    },
    "anger-track": {
      "$description": "The anger meter's track until ui-1.2.0: the base with round ends since ui-2.0.0 (deprecated since ui-1.3.0).",
      "$deprecated": "The anger meter is one ProgressBar since ui-1.3.0 (ToyBarAngerCalm): its own background is the track. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarAngerTrack", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 225, "unit": "px" } },
        "height": { "$value": { "value": 30, "unit": "px" } }
      }
    },
    "anger": {
      "$description": "The anger fill until ui-1.2.0: the danger colour with round ends since ui-2.0.0 (deprecated since ui-1.3.0).",
      "$deprecated": "Use ToyBarAngerCalm (and ToyBarAngerAlarm over the alarm line) since ui-1.3.0. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyBarAnger",
            "class": "ProgressBar",
            "on": ["ToyBarAngerTrack"],
            "replacement": "ToyBarAngerCalm"
          },
          "context": "dark"
        }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "anger-calm": {
      "$description": "The neighbours' anger while calm (the target's meter A): a 240 x 16 base track with fully round ends and a muted grey fill, so the round stays quiet.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarAngerCalm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.calm}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 240, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "anger-alarm": {
      "$description": "The neighbours' anger past its alarm line (over 70 %): the same bar, its fill in the danger colour; calm everywhere but the loud moments, so no light and no pulse. The game swaps ToyBarAngerCalm and this at the line and turns the siren danger too.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarAngerAlarm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 240, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "health-calm": {
      "$description": "Health as one bar (ui-1.3.0 to 1.4.0): the base track and the accent fill. Health and stamina are segmented pips since ui-2.0.0 (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm), which a ProgressBar cannot draw.",
      "$deprecated": "ui-2.0.0: health and stamina are ten segmented pips (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm in a ToyRowFour); removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarHealthCalm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.health-full}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "health-alarm": {
      "$description": "Health as one bar (ui-1.3.0 to 1.4.0): the base track and the danger fill. Health and stamina are segmented pips since ui-2.0.0 (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm), which a ProgressBar cannot draw.",
      "$deprecated": "ui-2.0.0: health and stamina are ten segmented pips (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm in a ToyRowFour); removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarHealthAlarm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "stamina-calm": {
      "$description": "Stamina as one bar (ui-1.3.0 to 1.4.0): the base track and the light text colour fill. Health and stamina are segmented pips since ui-2.0.0 (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm), which a ProgressBar cannot draw.",
      "$deprecated": "ui-2.0.0: health and stamina are ten segmented pips (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm in a ToyRowFour); removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarStaminaCalm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.stamina}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "stamina-alarm": {
      "$description": "Stamina as one bar (ui-1.3.0 to 1.4.0): the base track and the danger fill. Health and stamina are segmented pips since ui-2.0.0 (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm), which a ProgressBar cannot draw.",
      "$deprecated": "ui-2.0.0: health and stamina are ten segmented pips (ToyPip, ToyPipHealth, ToyPipStamina, ToyPipAlarm in a ToyRowFour); removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarStaminaAlarm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "return-calm": {
      "$description": "The dead's room return: the base track and the accent fill, 16 px tall, the screen giving the width.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarReturnCalm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.progress}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "return-alarm": {
      "$description": "The dead's room return in its last 5 s: the fill in the danger colour.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBarReturnAlarm", "class": "ProgressBar" },
          "context": "dark"
        }
      },
      "background": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "fill": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      }
    },
    "pip": {
      "$description": "An empty pip of the suit's health or stamina (the engineer's segmented pips, 2026-10-21): a 23 x 15 base tile with 5 px corners (the target's 15 x 10 and 3 px x 1.5). Ten pips in a ToyRowFour make a meter; the game sets each pip's variation from the value (round(value x 10) full pips).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPip", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.track}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } }
      }
    },
    "pip-health": {
      "$description": "A full health pip: the accent.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPipHealth", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.health-full}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } }
      }
    },
    "pip-stamina": {
      "$description": "A full stamina pip: the light text colour, so the two meters differ by colour and by their label.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPipStamina", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.stamina}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } }
      }
    },
    "pip-alarm": {
      "$description": "A full pip under the alarm line (health under 30 %): the danger colour; the meter's label turns danger too (ToyTextAlertOnLight).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
