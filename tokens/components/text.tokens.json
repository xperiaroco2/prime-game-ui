{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "text": {
    "$description": "Text roles: light #ECE8F7 and dim #A39DBD on the ground and in tiles; no outline (the tiles carry the text).",
    "on-dark": {
      "$description": "Text on the ground: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextOnDark", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "muted-on-dark": {
      "$description": "Dim text on the ground.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextMutedOnDark", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text-muted}" }
      }
    },
    "title-on-dark": {
      "$description": "A title on the ground: light, bold, no outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleOnDark", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.title}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.clear}" }
      },
      "items": {
        "$description": "No outline since ui-2.0.0 (the tiles carry the text): Godot's shadow outline at size 0.",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "on-light": {
      "$description": "Text in a tile: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "muted-on-light": {
      "$description": "Dim text in a tile (a label like Здоровʼя).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextMutedOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "title-on-light": {
      "$description": "A title in a tile (the machine screen's title): light, bold, no outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.title}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.clear}" }
      },
      "items": {
        "$description": "No outline since ui-2.0.0 (the tiles carry the text): Godot's shadow outline at size 0.",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "display-on-light": {
      "$description": "A big number in a tile: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyDisplayOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display-large}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "display-alert-on-light": {
      "$description": "A big word in the danger colour in a tile (the human's role in the Esc menu).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyDisplayAlertOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display-large}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.status.alert}" }
      }
    },
    "timer": {
      "$description": "The round time in its tile: light (the target's 24 px x 1.5 = 36).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTimer", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "hud-caption": {
      "$description": "A HUD caption (the suit tile's Здоровʼя and Витривалість): dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHudCaption", "class": "Label", "on": ["ToyBarLabel", "ToyChipPlate", "ToyPlate"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text-muted}" }
      }
    },
    "timer-bare": {
      "$description": "The round time without a tile: light with the 6 px shade halo, so it reads on the world (the target puts it in the time tile, ToyPlate).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTimerBare", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.shade}" }
      },
      "items": {
        "$description": "The shade halo around the letters on the world: a font shadow at no offset whose outline is stroke.halo (Godot draws shadow_outline_size outside the glyphs).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.halo}" }
      }
    },
    "text-alert-on-light": {
      "$description": "A label in the danger colour in a tile (the anger meter's label past its alarm line, the health label under 30 %).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextAlertOnLight", "class": "Label", "on": ["ToyPlate"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.status.alert}" }
      }
    },
    "text-on-danger": {
      "$description": "Text on a danger face (the cops' end, the danger band): the danger ink #26060C.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyTextOnDanger",
            "class": "Label",
            "on": ["ToyBackdropAlert", "ToyBandAlert", "ToyPlateBanner"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-large-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-danger.text}" }
      }
    },
    "kicker": {
      "$description": "A tile's kicker (the target's .tab: ЧАС, ГНІВ, КОСТЮМ): Unbounded capitals, dim, 2 px apart; the game writes the word in capitals.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKicker", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.kicker}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    }
  }
}
