{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "text": {
    "$description": "Text roles: Label variations. Dark (the world, the backdrops, the HUD plates) and light (inside a purple panel) read the same: mint text, muted dim text, alien green titles with an ink outline, numbers in Rubik.",
    "on-dark": {
      "$description": "Body text on dark: mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextOnDark", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "muted-on-dark": {
      "$description": "Muted text on dark: the muted lilac.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextMutedOnDark", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text-muted}" }
      }
    },
    "title-on-dark": {
      "$description": "A title on dark: Nunito Black in the alien green with a 6 px ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleOnDark", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.title}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "items": {
        "$description": "The ink outline around the letters: a font shadow at no offset whose outline is the outline width (Godot draws shadow_outline_size outside the glyph edge).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.surface}" }
      }
    },
    "on-light": {
      "$description": "Body text inside a panel (the light context, now purple): mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "muted-on-light": {
      "$description": "Muted text inside a panel: the muted lilac.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTextMutedOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "title-on-light": {
      "$description": "A title inside a panel: Nunito Black in the alien green with a 6 px ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.title}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "items": {
        "$description": "The ink outline around the letters: a font shadow at no offset whose outline is the outline width (Godot draws shadow_outline_size outside the glyph edge).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.surface}" }
      }
    },
    "display-on-light": {
      "$description": "A big number or word inside a panel (the volume and threshold readouts, a lobby code): Rubik in mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyDisplayOnLight", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display-large}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "timer": {
      "$description": "The round timer: Rubik in mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTimer", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "hud-caption": {
      "$description": "A HUD caption on a bar label or a plate chip: mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHudCaption", "class": "Label", "on": ["ToyBarLabel", "ToyChipPlate"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "timer-bare": {
      "$description": "The round timer with no plate (the engineer, 2026-10-20): mint Rubik digits with the 6 px ink outline, as the titles draw it, so they read on a white wall and a dark room; centred at the top. ToyPlateTimer stays for a timer on a plate.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTimerBare", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" },
        "font-shadow-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "items": {
        "$description": "The ink outline around the letters: a font shadow at no offset whose outline is the outline width (Godot draws shadow_outline_size outside the glyph edge).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.surface}" }
      }
    }
  }
}
