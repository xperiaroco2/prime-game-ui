{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "panel": {
    "$description": "Sticker panels: a 4 px ink outline and a hard ink shadow 5 px right and 5 px down (the base layer).",
    "menu": {
      "$description": "The menu panel: purple face, ink outline, on the hard ink shadow; the light context (its labels are mint).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPanelMenu", "class": "PanelContainer", "base": { "any": "ToyBasePanel" } },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }
      }
    },
    "dialog": {
      "$description": "The dialog panel: as the menu panel with more room.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPanelDialog", "class": "PanelContainer", "base": { "any": "ToyBasePanel" } },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } }
      }
    },
    "howto": {
      "$description": "The how-to card panel: as the menu panel; its frames are the mint plates the sketches sit on.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPanelHowto", "class": "PanelContainer", "base": { "any": "ToyBasePanel" } },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 26, "unit": "px" } }
      }
    },
    "base": {
      "$description": "The hard ink shadow under panels and the map board: the face's shape moved 5 px right and 5 px down.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBasePanel", "class": "Panel" },
          "context": "any"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.drop}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -5, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "expand-margin-left": { "$type": "dimension", "$value": { "value": -5, "unit": "px" } }
      }
    }
  }
}
