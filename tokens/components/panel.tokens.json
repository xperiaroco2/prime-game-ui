{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "panel": {
    "$description": "Panels: the plain tile, a module fill with a 2 px edge and 12 px corners, no hard shadow.",
    "menu": {
      "$description": "The suit menu's panel: the plain tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPanelMenu", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } }
      }
    },
    "dialog": {
      "$description": "A dialog and a machine's screen frame: the plain tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPanelDialog", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 42, "unit": "px" } }
      }
    },
    "howto": {
      "$description": "The how-to card: the plain tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPanelHowto", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }
      }
    },
    "base": {
      "$description": "The shadow layer under a panel until ui-1.4.0; clear since ui-2.0.0.",
      "$deprecated": "ui-2.0.0: the plain tile has no hard shadow; the game can drop it. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBasePanel", "class": "Panel" },
          "context": "any"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -8, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-left": { "$type": "dimension", "$value": { "value": -8, "unit": "px" } }
      }
    }
  }
}
