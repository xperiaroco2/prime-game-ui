{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "keycap": {
    "$description": "Keycaps (the target's .key): a row tile with the 2 px edge and a 5 px bottom edge, 6 px corners, light text.",
    "on-dark": {
      "$description": "A key on the ground.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyOnDark", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": { "$value": { "value": 144, "unit": "px" }, "$description": "The wide keycap's minimum width." }
      }
    },
    "on-light": {
      "$description": "A key in a tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyOnLight", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": { "$value": { "value": 144, "unit": "px" }, "$description": "The wide keycap's minimum width." }
      }
    },
    "quiet": {
      "$description": "A quiet key (a hint that is not the point): the base tile, dim text.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyQuiet", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": { "$value": { "value": 144, "unit": "px" }, "$description": "The wide keycap's minimum width." }
      }
    },
    "round": {
      "$description": "A round key (the map's ?).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyRound", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" }
      }
    },
    "round-quiet": {
      "$description": "A quiet round key.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyRoundQuiet", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" }
      }
    },
    "round-button": {
      "$description": "A round keycap button (the map's ?): the round key; focus an accent ring.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyRoundButton", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" }
      }
    },
    "button": {
      "$description": "A keycap button (rebinding): the key tile; hover lifts, held drops to the base; focus an accent ring 3 px outside (corners 6 + 6).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyButton", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": { "$value": { "value": 144, "unit": "px" }, "$description": "The wide keycap's minimum width (Shift, Space, the mouse buttons)." }
      }
    },
    "text": {
      "$description": "A key's label: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyText", "class": "Label", "on": ["ToyKeyOnDark", "ToyKeyOnLight", "ToyKeyRound"] },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "quiet-text": {
      "$description": "A quiet key's label: dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyQuietText", "class": "Label", "on": ["ToyKeyQuiet", "ToyKeyRoundQuiet"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    }
  }
}
