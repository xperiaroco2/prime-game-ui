{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "keycap": {
    "$description": "Keycaps: mint stickers, a 3 px ink outline with a 5 px ink bottom edge, ink key names.",
    "on-dark": {
      "$description": "A keycap on dark: the mint face, ink outline and bottom edge.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyOnDark", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": {
          "$value": { "value": 96, "unit": "px" },
          "$description": "The wide keycap's minimum width."
        }
      }
    },
    "on-light": {
      "$description": "A keycap in a panel: the mint face, ink outline and bottom edge.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyOnLight", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": {
          "$value": { "value": 96, "unit": "px" },
          "$description": "The wide keycap's minimum width."
        }
      }
    },
    "quiet": {
      "$description": "A dim keycap: the lilac face, soft-ink outline and edge.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyQuiet", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.muted}" },
        "border-color": { "$type": "color", "$value": "{palette.ink-soft}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": {
          "$value": { "value": 96, "unit": "px" },
          "$description": "The wide keycap's minimum width."
        }
      }
    },
    "round": {
      "$description": "A round keycap (the map's \"?\").",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyRound", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" }
      }
    },
    "round-quiet": {
      "$description": "A dim round keycap.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyRoundQuiet", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.muted}" },
        "border-color": { "$type": "color", "$value": "{palette.ink-soft}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" }
      }
    },
    "round-button": {
      "$description": "The round keycap as a button (the \"?\" next to a task): the ToyKeyRound face, a lighter mint hover, a darker mint held, unplugged when disabled, an outer mint focus ring (it sits on purple).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyRoundButton", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the mint one step lighter.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-light}" }
      },
      "pressed": {
        "$description": "Held: the mint one step darker (the key does not move).",
        "bg-color": { "$type": "color", "$value": "{palette.mint-dark}" }
      },
      "disabled": {
        "$description": "Unplugged: the lilac face, soft-ink outline and label.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a mint ring of the focus width, the focus gap outside the outline.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" }
      }
    },
    "button": {
      "$description": "A keycap as a button (rebinding in Settings > Controls): the ToyKeyOnLight face, a lighter mint hover, a darker mint held, unplugged when disabled, an outer mint focus ring (it sits on purple) that follows the keycap's corners.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyButton", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.bold}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the mint one step lighter.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-light}" }
      },
      "pressed": {
        "$description": "Held (and waiting for a key): the mint one step darker.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-dark}" }
      },
      "disabled": {
        "$description": "Unplugged: the lilac face, soft-ink outline and label.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a mint ring of the focus width, the focus gap outside the outline, following the keycap's corners (radius.small + the expand margin).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "min-width": { "$value": "{size.keycap}" },
        "wide-min-width": {
          "$value": { "value": 96, "unit": "px" },
          "$description": "The wide keycap's minimum width (Shift, Space, the mouse buttons)."
        }
      }
    },
    "text": {
      "$description": "The key name on a keycap.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyKeyText",
            "class": "Label",
            "on": ["ToyKeyOnDark", "ToyKeyOnLight", "ToyKeyRound"]
          },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "quiet-text": {
      "$description": "The key name on a dim keycap.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyKeyQuietText", "class": "Label", "on": ["ToyKeyQuiet", "ToyKeyRoundQuiet"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{palette.ink-soft}" }
      }
    }
  }
}
