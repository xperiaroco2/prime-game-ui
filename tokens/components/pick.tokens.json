{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "pick": {
    "$description": "Pickers on the purple panel: colour swatches, round radios and the check box.",
    "swatch-ring": {
      "$description": "The ring around a colour swatch (the fill is a white Panel tinted by self_modulate): the 6 px ink sticker outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySwatchRing", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 60, "unit": "px" } },
        "height": { "$value": { "value": 60, "unit": "px" } }
      }
    },
    "swatch-selected": {
      "$description": "The selected swatch ring: green, 6 px, 5 px outside the swatch.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySwatchSelected", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{palette.green}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } }
      }
    },
    "swatch-focus": {
      "$description": "The focused swatch: a 5 px mint ring flush outside the disc (it reads on the purple), unlike the chosen swatch's gapped green ring.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySwatchFocus", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "check-box": {
      "$description": "A bare CheckBox's look (Godot's CheckBox base type, prime-game-ui#52): borderless on the purple, the box texture at its left (42 px: empty mint, checked green with an ink check) and the mint label 12 px after it. Hover lays the lighter purple under it, checked or not (the box shows the check). It sets every item a Button sets, so the Button base type never reaches it.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyCheckBox", "class": "CheckBox",
            "textures": {
              "checked": "icons/checkbox-checked.svg", "checked-disabled": "icons/checkbox-checked-disabled.svg",
              "unchecked": "icons/checkbox-unchecked.svg", "unchecked-disabled": "icons/checkbox-unchecked-disabled.svg"
            }
          },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "$description": "No plate: Godot draws the box at the left content margin, centred in the height.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-right": { "$type": "dimension", "$value": "{space.16}" },
        "content-margin-left": { "$type": "dimension", "$value": "{space.12}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "$description": "Hover: the lighter purple laid under the box and label.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "hover-pressed": {
        "$description": "Checked and hovered: the same hover fill.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "disabled": {
        "$description": "Unplugged, checked or not (Godot has one disabled StyleBox; the box texture shows the check): only the label goes muted.",
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "$description": "Inner focus at the edge of the borderless check box: a mint ring (it reads on the purple).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "items": {
        "$description": "The gap between the box and the label, and an icon (Button's own) in the label colour of each state.",
        "h-separation": { "$type": "dimension", "$value": "{space.12}" },
        "icon-normal-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-hover-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-pressed-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-hover-pressed-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-disabled-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" },
        "icon-focus-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "radio": {
      "$description": "A round picker (a radio): a mint sticker disc, 6 px ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyRadio",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyRadioSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the face lifts to a lighter shade.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-light}" }
      },
      "pressed": {
        "$description": "Held: the face darkens.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-dark}" }
      },
      "disabled": {
        "$description": "Unplugged picker: a dulled lilac face, its outline in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a mint ring of the focus width, the focus gap outside the outline (it reads on the purple).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 39, "unit": "px" } },
        "height": { "$value": { "value": 39, "unit": "px" } }
      }
    },
    "radio-selected": {
      "$description": "The selected round picker: the green sticker disc.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyRadioSelected", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.green}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the selected face lifts to the lighter green.",
        "bg-color": { "$type": "color", "$value": "{palette.green-light}" }
      },
      "hover-pressed": {
        "$description": "Selected and hovered (a toggle rests pressed): as hover.",
        "bg-color": { "$type": "color", "$value": "{palette.green-light}" }
      },
      "disabled": {
        "$description": "Unplugged picker: a dulled lilac face, its outline in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a mint ring of the focus width, the focus gap outside the outline (it reads on the purple).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 39, "unit": "px" } },
        "height": { "$value": { "value": 39, "unit": "px" } }
      }
    }
  }
}
