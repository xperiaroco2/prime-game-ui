    "base-raised-on-dark": {
      "$description": "The hard ink shadow under the secondary and danger buttons on purple: 8 px right and 8 px down.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBaseRaisedOnDark", "class": "Panel" },
