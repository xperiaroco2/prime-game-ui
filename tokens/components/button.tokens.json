        "$description": "Hover fill.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-dark}" }
      },
      "pressed": {
        "$description": "Held: as hover.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-dark}" }
      },
      "disabled": {
        "$description": "Unplugged ghost: a quiet label.",
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "$description": "Inner focus: a ring inside the outline, the focus width wide.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "ghost-on-light": {
      "$description": "A quiet action inside a purple panel: no face and no outline, a mint label; hover lays the lighter purple under it.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyButtonGhostOnLight", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
