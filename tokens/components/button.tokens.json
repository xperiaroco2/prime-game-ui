        "$description": "Held, and the open entry (toggled on): the alien green face, as the primary button; the sticker does not move (the edge stays).",
        "bg-color": { "$type": "color", "$value": "{palette.green}" }
      },
      "disabled": {
        "$description": "Unplugged entry: no shadow (a 6 px outline on every side, no expand), a dulled lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
