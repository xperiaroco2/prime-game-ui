        "expand-margin": { "$type": "dimension", "$value": { "value": -6, "unit": "px" } }
      },
      "items": {
        "$description": "The pointer icon: clear at rest and unplugged, ink (the label colour) on hover, focus and while open; 18 px between the pointer and the label.",
        "icon-normal-color": { "$type": "color", "$value": "{palette.clear}" },
        "icon-hover-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-pressed-color": { "$type": "color", "$value": "{color.on-accent.text}" },
