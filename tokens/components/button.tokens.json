    "menu-item": {
      "$description": "A main-menu entry on purple: the mint sticker (6 px ink outline, the ink heading label in Nunito Black) with a pointer icon that shows on hover, focus and while open (toggle_mode: pressed is the open entry). The hard shadow is the edge form: the right and bottom outlines are 14 px (6 + 8) and reach 8 px outside the entry, as no base layer sits under a menu entry in the game.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMenuItem", "class": "Button", "parent": "ToyButton" },
          "context": "dark"
        }
      },
