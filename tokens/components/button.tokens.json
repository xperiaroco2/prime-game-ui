    "ghost-on-dark": {
      "$description": "A quiet action on purple: no face and no outline, a mint label; hover lays a lighter purple under it.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyButtonGhostOnDark", "class": "Button", "parent": "ToyButton" },
