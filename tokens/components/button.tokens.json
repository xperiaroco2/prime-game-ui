{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "button": {
    "$description": "Buttons of the plain tile (ui-2.0.0): the main action and danger are bright faces with a deeper 5 px bottom edge (the target's .btn), the rest are row-coloured faces with a 2 px edge or outline, 9 px corners; no hard shadow, no glow, no base layer. One type variation per group with a godot.variation.",
    "common": {
      "$description": "The abstract parent of every Toy button: press timing and zero offsets (no button moves since ui-2.0.0).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyButton", "class": "Button", "abstract": true },
          "context": "any"
        }
      },
      "motion": { "$type": "transition", "$value": "{motion.press}" },
      "press": {
        "$type": "dimension",
        "depth": { "$value": { "value": 0, "unit": "px" } },
        "hover": { "$value": { "value": 0, "unit": "px" } },
        "held": { "$value": { "value": 0, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "primary": {
      "$description": "The main action (the target's .btn): the accent #6FF2B4 with the accent ink #082418, a 5 px deeper accent #33A877 at the bottom (the 3 px x 1.5), 9 px corners; hover lifts, held darkens; unplugged a row face with dim text; focus an accent ring 3 px outside the face.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyButtonPrimary", "class": "Button", "parent": "ToyButton" },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-color": { "$type": "color", "$value": "{palette.accent-deep}" },
        "border-width-top": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-right": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.edge}" },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 17, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.accent-light}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.accent-dark}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      },
      "items": {
        "$description": "An icon (the ready toggle's check) in the label colour of each state; without these Godot tints it white.",
        "icon-normal-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-hover-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-pressed-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-hover-pressed-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-disabled-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "icon-focus-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
