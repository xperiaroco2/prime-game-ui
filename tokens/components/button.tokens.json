      "$description": "The hard ink shadow under the secondary and danger buttons on mint: 8 px right and 8 px down.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBaseRaisedOnLight", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.on-light.base}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -8, "unit": "px" } },
