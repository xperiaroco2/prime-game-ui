{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "button": {
    "$description": "Sticker buttons (Ink and mint, strength B): a bright face, a 6 px ink outline and a hard ink shadow 8 px right and 8 px down (the base layer). One type variation per group with a godot.variation.",
    "common": {
      "$description": "The abstract parent of every Toy button: press timing and zero offsets.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyButton", "class": "Button", "abstract": true },
          "context": "any"
        }
      },
      "motion": { "$type": "transition", "$value": "{motion.press}" },
      "press": {
        "$type": "dimension",
        "depth": { "$value": { "value": 0, "unit": "px" } },
        "hover": { "$value": { "value": 0, "unit": "px" } },
        "held": { "$value": { "value": 0, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "primary": {
      "$description": "The main action: the alien green sticker.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyButtonPrimary",
            "class": "Button",
            "parent": "ToyButton",
            "base": { "dark": "ToyBasePrimaryOnDark", "light": "ToyBasePrimaryOnLight" }
          },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-large-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.green}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the face lifts to a lighter shade.",
        "bg-color": { "$type": "color", "$value": "{palette.green-light}" }
      },
      "pressed": {
        "$description": "Held: the face darkens; the sticker does not move (the shadow stays).",
        "bg-color": { "$type": "color", "$value": "{palette.green-dark}" }
      },
      "disabled": {
        "$description": "Unplugged: no shadow (the base is hidden), a dulled lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Inner focus: a ring inside the outline, the focus width wide.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -6, "unit": "px" } }
      },
      "press": {
        "$type": "dimension",
        "depth": {
          "$description": "The base sits offset.base right and down: the hard ink shadow.",
          "$value": "{offset.base}"
        },
        "hover": { "$value": { "value": 0, "unit": "px" } },
        "held": { "$value": { "value": 0, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      },
      "items": {
        "$description": "An icon (the ready toggle's check) in the label colour of each state; without these Godot tints it white.",
        "icon-normal-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-hover-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-pressed-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-hover-pressed-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-disabled-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "icon-focus-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "secondary": {
      "$description": "A second action: the mint sticker.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyButtonSecondary",
            "class": "Button",
            "parent": "ToyButton",
            "base": { "dark": "ToyBaseRaisedOnDark", "light": "ToyBaseRaisedOnLight" }
          },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-large-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the face lifts to a lighter shade.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-light}" }
      },
      "pressed": {
        "$description": "Held: the face darkens; the sticker does not move (the shadow stays).",
        "bg-color": { "$type": "color", "$value": "{palette.mint-dark}" }
      },
      "disabled": {
        "$description": "Unplugged: no shadow (the base is hidden), a dulled lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
