{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "preset-card": {
    "$description": "Preset cards: row tiles with the 2 px edge and 12 px corners; the chosen one keeps its face with a 3 px accent outline.",
    "idle": {
      "$description": "A preset card: a row tile with the 2 px edge and 12 px corners, light text; hover lifts, held drops to the base; focus an accent ring inside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPresetCard",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyPresetCardSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } }
      }
    },
    "selected": {
      "$description": "The chosen preset card: the row tile with a 3 px accent outline (the target's chosen card).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardSelected", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.selected}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "hover-pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -3, "unit": "px" } }
      }
    },
    "quiet": {
      "$description": "A quiet card (Save): the base tile with the 2 px edge and dim text; hover and held light the edge dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardQuiet", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "hover": {
        "border-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "pressed": {
        "border-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "disabled": {},
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } }
      }
    },
    "note": {
      "$description": "A card's note: dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardNote", "class": "Label", "on": ["ToyPresetCard"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "note-selected": {
      "$description": "The chosen card's note: dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardNoteSelected", "class": "Label", "on": ["ToyPresetCardSelected"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "name": {
      "$description": "A card's name: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardName", "class": "Label", "on": ["ToyPresetCard", "ToyPresetCardSelected"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "base": {
      "$description": "The shadow layer under a card until ui-1.4.0; clear since ui-2.0.0.",
      "$deprecated": "ui-2.0.0: the plain tile has no hard shadow; the game can drop it. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBaseCard", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -8, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-left": { "$type": "dimension", "$value": { "value": -8, "unit": "px" } }
      }
    }
  }
}
