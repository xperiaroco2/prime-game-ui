{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "preset-card": {
    "$description": "Preset cards: a toggle pair on a card base, plus a quiet card.",
    "idle": {
      "$description": "An idle preset card: white face, ink outline, a 5 px card base.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPresetCard",
            "class": "Button",
            "parent": "ToyButton",
            "base": { "any": "ToyBaseCard" },
            "toggle": { "selected": "ToyPresetCardSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "disabled": {
        "$description": "Unplugged: the base is hidden, the face rests, pale and quiet.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Inner focus: the outline thickens inward by the focus width.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -3, "unit": "px" } }
      },
      "press": {
        "$type": "dimension",
        "depth": { "$value": { "value": 5, "unit": "px" } },
        "hover": {
          "$value": { "value": -1, "unit": "px" },
          "$description": "The hover lift (proposal).",
          "$extensions": { "io.github.xperiaroco2.prime-game": { "proposal": true } }
        },
        "held": { "$value": { "value": 3, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "selected": {
      "$description": "The selected preset card: yellow face, a 4 px outline, the same outer size.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPresetCardSelected",
            "class": "Button",
            "parent": "ToyButton",
            "base": { "any": "ToyBaseCard" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.yellow}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "disabled": {
        "$description": "Unplugged: the base is hidden, the face rests, pale and quiet.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Inner focus: the outline thickens inward by the focus width.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      },
      "press": {
        "$type": "dimension",
        "depth": { "$value": { "value": 5, "unit": "px" } },
        "hover": {
          "$value": { "value": -1, "unit": "px" },
          "$description": "The hover lift (proposal).",
          "$extensions": { "io.github.xperiaroco2.prime-game": { "proposal": true } }
        },
        "held": { "$value": { "value": 3, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "quiet": {
      "$description": "The quiet \"save your own\" card: lavender, muted, no base, not a toggle.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardQuiet", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.lavender}" },
        "border-color": { "$type": "color", "$value": "{palette.muted}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{palette.muted}" }
      },
      "disabled": {
        "$description": "As normal: the quiet card is already quiet."
      },
      "focus": {
        "$description": "Inner focus: the outline thickens inward by the focus width.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -3, "unit": "px" } }
      },
      "press": {
        "$type": "dimension",
        "depth": { "$value": { "value": 0, "unit": "px" } },
        "hover": { "$value": { "value": 0, "unit": "px" } },
        "held": { "$value": { "value": 3, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "note": {
      "$description": "The note on an idle preset card.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardNote", "class": "Label", "on": ["ToyPresetCard"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "note-selected": {
      "$description": "The note on the selected preset card.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardNoteSelected", "class": "Label", "on": ["ToyPresetCardSelected"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text-muted}" }
      }
    },
    "base": {
      "$description": "The 5 px ink base under preset cards.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBaseCard", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.on-light.base}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -5, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    }
  }
}
