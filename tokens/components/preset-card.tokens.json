{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "preset-card": {
    "$description": "Preset cards: a toggle pair of stickers (inside a purple panel) on the ink card base, the hard shadow 5 px right and 5 px down, plus a quiet card.",
    "idle": {
      "$description": "An idle preset card: the mint sticker, a 4 px ink outline, ink text, on the ink card base (the hard shadow).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPresetCard",
            "class": "Button",
            "parent": "ToyButton",
            "base": { "any": "ToyBaseCard" },
            "toggle": { "selected": "ToyPresetCardSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the face lifts to a lighter mint.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-light}" }
      },
      "pressed": {
        "$description": "Held: the face darkens; the sticker does not move (the shadow stays).",
        "bg-color": { "$type": "color", "$value": "{palette.mint-dark}" }
      },
      "disabled": {
        "$description": "Unplugged: no shadow (the base is hidden), the lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Inner focus: a ring inside the outline, the focus width wide.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      },
      "press": {
        "$type": "dimension",
        "depth": {
          "$description": "The base sits offset.base right and down: the hard ink shadow.",
          "$value": "{offset.base}"
        },
        "hover": { "$value": { "value": 0, "unit": "px" } },
        "held": { "$value": { "value": 0, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "selected": {
      "$description": "The selected preset card: the alien green sticker, a 4 px ink outline, ink text, the same outer size and base.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPresetCardSelected",
            "class": "Button",
            "parent": "ToyButton",
            "base": { "any": "ToyBaseCard" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.green}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the selected face lifts to the lighter green.",
        "bg-color": { "$type": "color", "$value": "{palette.green-light}" }
      },
      "hover-pressed": {
        "$description": "Selected and hovered (a toggle rests pressed): as hover.",
        "bg-color": { "$type": "color", "$value": "{palette.green-light}" }
      },
      "disabled": {
        "$description": "Unplugged: no shadow (the base is hidden), the lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Inner focus: a ring inside the outline, the focus width wide.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      },
      "press": {
        "$type": "dimension",
        "depth": {
          "$description": "The base sits offset.base right and down: the hard ink shadow.",
          "$value": "{offset.base}"
        },
        "hover": { "$value": { "value": 0, "unit": "px" } },
        "held": { "$value": { "value": 0, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "quiet": {
      "$description": "The quiet \"save your own\" card: the lilac face with a soft-ink outline and an ink label, flat (no base), not a toggle.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardQuiet", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.muted}" },
        "border-color": { "$type": "color", "$value": "{palette.ink-soft}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the outline turns full ink.",
        "border-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "pressed": {
        "$description": "Held: the outline stays full ink; the card does not move.",
        "border-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "disabled": {
        "$description": "As normal: the quiet card is already quiet."
      },
      "focus": {
        "$description": "Inner focus: a ring inside the outline, the focus width wide.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      },
      "press": {
        "$type": "dimension",
        "depth": { "$value": { "value": 0, "unit": "px" } },
        "hover": { "$value": { "value": 0, "unit": "px" } },
        "held": { "$value": { "value": 0, "unit": "px" } },
        "disabled": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "note": {
      "$description": "The note on an idle preset card: the soft ink on mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardNote", "class": "Label", "on": ["ToyPresetCard"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text-muted}" }
      }
    },
    "note-selected": {
      "$description": "The note on the selected preset card: the soft ink on green.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardNoteSelected", "class": "Label", "on": ["ToyPresetCardSelected"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text-muted}" }
      }
    },
    "name": {
      "$description": "The preset's name on a preset card, idle or selected (ink on both faces).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPresetCardName", "class": "Label", "on": ["ToyPresetCard", "ToyPresetCardSelected"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "base": {
      "$description": "The hard ink shadow under preset cards: the card's shape moved 5 px right and 5 px down.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBaseCard", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.on-light.base}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -5, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "expand-margin-left": { "$type": "dimension", "$value": { "value": -5, "unit": "px" } }
      }
    }
  }
}
