{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "name-plate": {
    "$description": "Name plates over players.",
    "plate": {
      "$description": "A name over a player's head (the target's world plates): no plate, the name alone with a dark halo.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyNamePlate", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "text": {
      "$description": "The name over a head: light text with a 6 px shade halo (the target's 4 px x 1.5), Godot's shadow outline at offset 0.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyNamePlateText", "class": "Label", "on": ["ToyNamePlate"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.shade}" }
      },
      "items": {
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.halo}" }
      }
    }
  }
}
