{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "name-plate": {
    "$description": "Name plates over players.",
    "plate": {
      "$description": "A name plate: a purple sticker pill, 6 px ink outline. The hard shadow is the edge form: the right and bottom outlines are 14 px (6 + 8) and reach 8 px outside the pill.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyNamePlate", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.control}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      }
    },
    "text": {
      "$description": "The name on a name plate: mint (also the teammate mark's tint).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyNamePlateText", "class": "Label", "on": ["ToyNamePlate"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    }
  }
}
