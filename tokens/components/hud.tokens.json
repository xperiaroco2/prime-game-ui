{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "hud": {
    "$description": "Small HUD parts.",
    "crosshair": {
      "$description": "The crosshair dot: white with a 3 px ink ring, so it reads on a dark room and on a white wall.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyCrosshair", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 8, "unit": "px" } },
        "height": { "$value": { "value": 8, "unit": "px" } }
      }
    },
    "spinner": {
      "$description": "The loading spinner: a green arc on a purple disc (rotated at runtime).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySpinner", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.night-plate}" },
        "border-color": { "$type": "color", "$value": "{palette.green}" },
        "border-width-top": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "border-width-right": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 90, "unit": "px" } },
        "height": { "$value": { "value": 90, "unit": "px" } }
      }
    }
  }
}
