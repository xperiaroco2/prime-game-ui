{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "hud": {
    "$description": "Small HUD parts.",
    "crosshair": {
      "$description": "The crosshair: a 12 px white dot with a 2 px shade ring, so it reads on a light or a dark world.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyCrosshair", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "border-color": { "$type": "color", "$value": "{palette.shade}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 12, "unit": "px" } },
        "height": { "$value": { "value": 12, "unit": "px" } }
      }
    },
    "spinner": {
      "$description": "The loading spinner: a quarter arc of 9 px accent that the game turns.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySpinner", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width-top": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-right": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 135, "unit": "px" } },
        "height": { "$value": { "value": 135, "unit": "px" } }
      }
    }
  },
    "divider": {
      "$description": "A thin upright line between two parts of a tile (the target's .time .div, new in ui-2.1.0): a 3 x 48 base fill (2 x 32 x 1.5) between the time and the anger.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTileDivider", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "size": {
        "width": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
      }
    }
}
