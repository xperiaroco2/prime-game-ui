{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "field": {
    "$description": "Text field, dropdown and number field (SpinBox).",
    "input": {
      "$description": "A text field: white box, ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyField", "class": "LineEdit" },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "focus": {
        "$description": "Inner focus: the outline thickens inward by the focus width.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      },
      "read-only": {
        "$description": "Read-only, also the guest's view: a quiet box with readable text.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "items": {
        "$description": "Placeholder, caret and selection colours.",
        "placeholder-color": { "$type": "color", "$value": "{palette.ink-soft}" },
        "caret-color": { "$type": "color", "$value": "{color.outline}" },
        "selection-color": { "$type": "color", "$value": "{palette.green}" },
        "selected-font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "dropdown": {
      "$description": "A dropdown: as the field; no parent, so OptionButton's own items still resolve.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyDropdown", "class": "OptionButton", "textures": { "arrow": "icons/chevron-down.svg" } },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "$description": "Hover fill.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "pressed": {
        "$description": "Held: as hover.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "disabled": {
        "$description": "Unplugged dropdown: pale and quiet.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Inner focus: the outline thickens inward by the focus width.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      },
      "items": {
        "$description": "The arrow (chevron-down, a white texture tinted by the label colour): Godot reserves its width itself (OptionButton's internal margin), it sits at the right content edge, 8 px after the text.",
        "arrow-margin": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "h-separation": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "modulate-arrow": { "$type": "number", "$value": 1 }
      }
    },
    "list": {
      "$description": "The dropdown's open list (the OptionButton's get_popup(), a PopupMenu): a cream panel with the dropdown's ink outline and corners, rows in the dropdown's text. The selected row shows an ink check (radio_checked); the other rows an empty icon of the same size (radio_unchecked), so every label starts at the same x.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyDropdownList", "class": "PopupMenu",
            "textures": {
              "radio-checked": "icons/radio-checked.svg", "radio-checked-disabled": "icons/radio-checked-disabled.svg",
              "radio-unchecked": "icons/radio-unchecked.svg", "radio-unchecked-disabled": "icons/radio-unchecked.svg"
            }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "panel": {
        "$description": "The list's frame: cream, the dropdown's 3 px ink outline and 12 px corners; the rows sit 4 px inside the outline.",
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 7, "unit": "px" } }
      },
      "hover": {
        "$description": "The hovered or keyboard-focused row (PopupMenu draws its focused item as hovered): the lavender quiet fill of the flat controls, its corners rounded inside the list's.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" }
      },
      "separator": {
        "$description": "A separator row: a 2 px ink line across the list (its height is its top content margin, the border width).",
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "items": {
        "$description": "Row text colours (ink; a disabled row muted) and the row layout: each row is its text plus v_separation (half above, half below, where the hover fill reaches), the check 8 px from the row's start and 8 px before the label, 16 px after the longest label.",
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "font-hover-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "font-disabled-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "v-separation": { "$type": "dimension", "$value": "{space.16}" },
        "h-separation": { "$type": "dimension", "$value": "{space.8}" },
        "item-start-padding": { "$type": "dimension", "$value": "{space.8}" },
        "item-end-padding": { "$type": "dimension", "$value": "{space.16}" }
      }
    },
    "spin-input": {
      "$description": "A SpinBox's field (Godot's SpinBoxInnerLineEdit, prime-game-ui#52): the text field with 12 px above and below instead of 10, so each of the SpinBox's two arrow buttons beside it is at least 24 px high.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySpinField", "class": "LineEdit" },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.white}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": "{space.12}" },
        "content-margin-inline": { "$type": "dimension", "$value": "{space.16}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "focus": {
        "$description": "Inner focus: the outline thickens inward by the focus width.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      },
      "read-only": {
        "$description": "Read-only, also the guest's view: a quiet box with readable text.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "items": {
        "$description": "Placeholder, caret and selection colours.",
        "placeholder-color": { "$type": "color", "$value": "{palette.ink-soft}" },
        "caret-color": { "$type": "color", "$value": "{color.outline}" },
        "selection-color": { "$type": "color", "$value": "{palette.green}" },
        "selected-font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "spin": {
      "$description": "A bare SpinBox's arrows (Godot's SpinBox base type, prime-game-ui#52): two stacked buttons 8 px right of the field, 2 px apart, in the setting stepper's colours (yellow, a thin ink outline, ink chevrons; honey while held, pale when unplugged), small corners. Its field is ToySpinField.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToySpinBox", "class": "SpinBox",
            "textures": {
              "up": "icons/spin-up.svg", "up-hover": "icons/spin-up.svg", "up-pressed": "icons/spin-up.svg", "up-disabled": "icons/spin-up.svg",
              "down": "icons/spin-down.svg", "down-hover": "icons/spin-down.svg", "down-pressed": "icons/spin-down.svg", "down-disabled": "icons/spin-down.svg"
            }
          },
          "context": "any"
        }
      },
      "up-background": {
        "$description": "The up button; the down button and every state complete from it.",
        "bg-color": { "$type": "color", "$value": "{palette.green}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.thin}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": "{space.4}" },
        "content-margin-inline": { "$type": "dimension", "$value": "{space.8}" }
      },
      "up-background-pressed": {
        "$description": "Held: the face turns honey.",
        "bg-color": { "$type": "color", "$value": "{color.state.held-accent}" }
      },
      "up-background-disabled": {
        "$description": "Unplugged at the limit or for a guest: pale and quiet.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "items": {
        "$description": "The layout (the buttons 34 px wide, 8 px from the field, 2 px apart) and the chevrons' tint: ink, the unplugged ink when disabled.",
        "buttons-width": { "$type": "dimension", "$value": { "value": 34, "unit": "px" } },
        "field-and-buttons-separation": { "$type": "dimension", "$value": "{space.8}" },
        "buttons-vertical-separation": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
        "up-icon-modulate": { "$type": "color", "$value": "{color.on-accent.text}" },
        "up-hover-icon-modulate": { "$type": "color", "$value": "{color.on-accent.text}" },
        "up-pressed-icon-modulate": { "$type": "color", "$value": "{color.on-accent.text}" },
        "up-disabled-icon-modulate": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "down-icon-modulate": { "$type": "color", "$value": "{color.on-accent.text}" },
        "down-hover-icon-modulate": { "$type": "color", "$value": "{color.on-accent.text}" },
        "down-pressed-icon-modulate": { "$type": "color", "$value": "{color.on-accent.text}" },
        "down-disabled-icon-modulate": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      }
    }
  }
}
