{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "field": {
    "$description": "Fields and the dropdown: the base cell or a row face with the 2 px edge, 9 px corners, light text; focus an accent ring inside the edge.",
    "input": {
      "$description": "A text field (the target's code cells): the base cell with the 2 px edge and 9 px corners, light text, a dim placeholder, an accent caret and an accent selection with the accent ink; focus an accent ring inside the edge; read-only a row face with dim text.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyField", "class": "LineEdit" },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{color.surface.field}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 7, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } }
      },
      "read-only": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "items": {
        "$description": "Placeholder, caret and selection colours.",
        "placeholder-color": { "$type": "color", "$value": "{color.on-light.text-muted}" },
        "caret-color": { "$type": "color", "$value": "{palette.accent}" },
        "selection-color": { "$type": "color", "$value": "{palette.accent}" },
        "selected-font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "dropdown": {
      "$description": "A dropdown (the target's .dd): a row face with the 2 px edge, light text and the chevron (tinted with the text), 9 px corners; hover lifts, open drops to the base; focus an accent ring inside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyDropdown",
            "class": "OptionButton",
            "textures": { "arrow": "icons/chevron-down.svg" }
          },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 7, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } }
      },
      "items": {
        "$description": "The arrow (chevron-down, a white texture tinted by the label colour): Godot reserves its width itself (OptionButton's internal margin), it sits at the right content edge, 8 px after the text.",
        "arrow-margin": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "h-separation": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "modulate-arrow": { "$type": "number", "$value": 1 }
      }
    },
    "list": {
      "$description": "A dropdown's open list (the game sets it on every OptionButton's get_popup()): a module tile with the 2 px edge and 9 px corners; the hovered or keyboard-focused row a row fill with 6 px corners; a separator a 2 px edge line; the selected row's check in the accent.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyDropdownList",
            "class": "PopupMenu",
            "textures": {
              "radio-checked": "icons/radio-checked.svg",
              "radio-checked-disabled": "icons/radio-checked-disabled.svg",
              "radio-unchecked": "icons/radio-unchecked.svg",
              "radio-unchecked-disabled": "icons/radio-unchecked.svg"
            }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" }
      },
      "separator": {
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "items": {
        "$description": "Row text colours (light on the module; a disabled row dim) and the row layout: each row is its text plus v_separation (half above, half below, where the hover fill reaches), the check 8 px from the row's start and 8 px before the label, 16 px after the longest label.",
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "font-hover-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "font-disabled-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "v-separation": { "$type": "dimension", "$value": "{space.16}" },
        "h-separation": { "$type": "dimension", "$value": "{space.8}" },
        "item-start-padding": { "$type": "dimension", "$value": "{space.8}" },
        "item-end-padding": { "$type": "dimension", "$value": "{space.16}" }
      }
    },
    "spin-input": {
      "$description": "The SpinBox's number field (Godot's SpinBoxInnerLineEdit): ToyField with 16 px above and below, so each arrow button is at least 24 px high.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySpinField", "class": "LineEdit" },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{color.surface.field}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 7, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } }
      },
      "read-only": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "items": {
        "$description": "Placeholder, caret and selection colours.",
        "placeholder-color": { "$type": "color", "$value": "{color.on-light.text-muted}" },
        "caret-color": { "$type": "color", "$value": "{palette.accent}" },
        "selection-color": { "$type": "color", "$value": "{palette.accent}" },
        "selected-font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "spin": {
      "$description": "A SpinBox's arrows (a base-type source): two row buttons with the 2 px edge and 6 px corners stacked 8 px right of the field, 3 px apart; light chevrons, dim when unplugged.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToySpinBox",
            "class": "SpinBox",
            "textures": {
              "up": "icons/spin-up.svg",
              "up-hover": "icons/spin-up.svg",
              "up-pressed": "icons/spin-up.svg",
              "up-disabled": "icons/spin-up.svg",
              "down": "icons/spin-down.svg",
              "down-hover": "icons/spin-down.svg",
              "down-pressed": "icons/spin-down.svg",
              "down-disabled": "icons/spin-down.svg"
            }
          },
          "context": "any"
        }
      },
      "up-background": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } }
      },
      "up-background-hovered": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "up-background-pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "up-background-disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" }
      },
      "items": {
        "$description": "The layout (the buttons 51 px wide, 8 px from the field, 3 px apart) and the chevrons' tint: light, dim when disabled.",
        "buttons-width": { "$type": "dimension", "$value": { "value": 51, "unit": "px" } },
        "field-and-buttons-separation": { "$type": "dimension", "$value": "{space.8}" },
        "buttons-vertical-separation": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
        "up-icon-modulate": { "$type": "color", "$value": "{color.on-light.text}" },
        "up-hover-icon-modulate": { "$type": "color", "$value": "{color.on-light.text}" },
        "up-pressed-icon-modulate": { "$type": "color", "$value": "{color.on-light.text}" },
        "up-disabled-icon-modulate": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "down-icon-modulate": { "$type": "color", "$value": "{color.on-light.text}" },
        "down-hover-icon-modulate": { "$type": "color", "$value": "{color.on-light.text}" },
        "down-pressed-icon-modulate": { "$type": "color", "$value": "{color.on-light.text}" },
        "down-disabled-icon-modulate": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      }
    }
  }
}
