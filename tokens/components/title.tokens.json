{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "title": {
    "$description": "The title plate and the logo: alien green letters with a 6 px ink outline.",
    "plate": {
      "$description": "The title plate: a purple sticker (ink outline, the hard ink shadow of its base) around a Nunito Black title in the alien green with an ink outline; expand margins replace the CSS negative margins.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitlePlate", "class": "Label", "base": { "any": "ToyBaseTitle" } },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.hero}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "expand-margin-block": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "expand-margin-inline": { "$type": "dimension", "$value": { "value": 54, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-dark.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "items": {
        "$description": "The ink outline around the letters: a font shadow at no offset whose outline is the outline width (Godot draws shadow_outline_size outside the glyph edge).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.surface}" }
      }
    },
    "base": {
      "$description": "The hard ink shadow under the title plate: its shape moved 8 px right and 8 px down.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBaseTitle", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.on-dark.base}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 62, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "expand-margin-left": { "$type": "dimension", "$value": { "value": 46, "unit": "px" } }
      }
    },
    "logo": {
      "$description": "The logo: Kablammo (the cartoon face, on the logo only) in the alien green with a 6 px ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyLogo", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.logo}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "items": {
        "$description": "The ink outline around the letters: a font shadow at no offset whose outline is the outline width (Godot draws shadow_outline_size outside the glyph edge).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.surface}" }
      }
    },
    "hero": {
      "$description": "A full-screen title with no plate (the alien role reveal, the aliens' won end): the alien green at the hero size with the 6 px ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleHero", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.hero}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "items": {
        "$description": "The ink outline around the letters: a font shadow at no offset whose outline is the outline width (Godot draws shadow_outline_size outside the glyph edge).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.surface}" }
      }
    },
    "hero-alert": {
      "$description": "A full-screen coral title (the human role reveal, the lost ends): as ToyTitleHero in the coral.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleHeroAlert", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.hero}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.status.alert}" },
        "font-shadow-color": { "$type": "color", "$value": "{color.outline}" }
      },
      "items": {
        "$description": "The ink outline around the letters: a font shadow at no offset whose outline is the outline width (Godot draws shadow_outline_size outside the glyph edge).",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": "{stroke.surface}" }
      }
    }
  }
}
