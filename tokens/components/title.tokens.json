{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "title": {
    "$description": "Titles: the loud ones are Unbounded on a band; no outline anywhere.",
    "plate": {
      "$description": "A title on its own tile (pre and post game): Unbounded on the plain tile, light, no outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitlePlate", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.hero}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{color.surface.panel}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "expand-margin-block": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "expand-margin-inline": { "$type": "dimension", "$value": { "value": 54, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-dark.title}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.clear}" }
      },
      "items": {
        "$description": "No outline since ui-2.0.0 (the tiles carry the text): Godot's shadow outline at size 0.",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "base": {
      "$description": "The shadow layer under the title plate until ui-1.4.0; clear since ui-2.0.0.",
      "$deprecated": "ui-2.0.0: the plain tile has no hard shadow; the game can drop it. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyBaseTitle", "class": "Panel" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "expand-margin-top": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 62, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "expand-margin-left": { "$type": "dimension", "$value": { "value": 46, "unit": "px" } }
      }
    },
    "logo": {
      "$description": "The logo: Unbounded in the accent, no outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyLogo", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.logo}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{palette.accent}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.clear}" }
      },
      "items": {
        "$description": "No outline since ui-2.0.0 (the tiles carry the text): Godot's shadow outline at size 0.",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "hero": {
      "$description": "A loud title on its band (the role reveal, the aliens' win; the target's 84 to 92 px titles x 1.5): Unbounded Bold at the hero size 126 in the accent ink on ToyBand. The game writes the role words in capitals.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleHero", "class": "Label", "on": ["ToyBand"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.hero-display}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.clear}" }
      },
      "items": {
        "$description": "No outline since ui-2.0.0 (the tiles carry the text): Godot's shadow outline at size 0.",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "hero-alert": {
      "$description": "A loud title on the danger band or the cops' end: Unbounded Bold at the hero size in the danger ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTitleHeroAlert", "class": "Label", "on": ["ToyBandAlert", "ToyBackdropAlert"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.hero-display}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-danger.text}" },
        "font-shadow-color": { "$type": "color", "$value": "{palette.clear}" }
      },
      "items": {
        "$description": "No outline since ui-2.0.0 (the tiles carry the text): Godot's shadow outline at size 0.",
        "shadow-offset-x": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-offset-y": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "shadow-outline-size": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    }
  }
}
