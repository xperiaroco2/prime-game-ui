{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "tab": {
    "$description": "Tabs (the target's .tabs since ui-2.1.0): text tabs in one row on a strip with a hairline under it; the chosen one light with a 3 px accent underline (a bottom border only), no fill.",
    "idle": {
      "$description": "A tab (the target's .tabs .t): dim text, no face; hover light text; focus an accent ring inside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyTab",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyTabSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "hover": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "pressed": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "disabled": {
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
                "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "selected": {
      "$description": "The chosen tab (the target's .tabs .t.on): light text over a 3 px accent underline (the target's 2 px x 1.5), a bottom border only, no fill; focus an accent ring inside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTabSelected", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width-top": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-right": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.selected}" },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "disabled": {
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
                        "expand-margin": { "$type": "dimension", "$value": { "value": -3, "unit": "px" } }
      }
    },
    "strip": {
      "$description": "The tab strip (the target's .tabs, new in ui-2.1.0): no fill, a 2 px edge line under the row (the target's 1 px x 1.5) and no margins but the line's own 2 px, so the chosen tab's underline stands right on the line; the row holds the tabs, then the small Esc keycap at the right (ToyKeyQuiet).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTabStrip", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-right": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": "{stroke.thin}" },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    }
  }
}
