{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "tab": {
    "$description": "The Esc menu tabs: a toggle pair (the game variation EscTab becomes a variation of ToyTab). On the purple panel: idle tabs are bare mint labels, the selected tab is a flat mint sticker.",
    "idle": {
      "$description": "An idle Esc tab: no fill, no outline, a mint label on the purple.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyTab",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyTabSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-large-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "$description": "Hover: the lighter purple laid under the label.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "pressed": {
        "$description": "Held: as hover.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "disabled": {
        "$description": "Unplugged tab: only the label goes muted.",
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "$description": "Inner focus at the edge of a borderless tab: a mint ring (it reads on the purple).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "selected": {
      "$description": "The selected Esc tab: a flat mint sticker, a 4 px ink outline on every side (no shadow), an ink label.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTabSelected", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-large-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "disabled": {
        "$description": "Unplugged selected tab: a dulled lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Inner focus: an ink ring of the focus width just inside the outline.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } }
      }
    }
  }
}
