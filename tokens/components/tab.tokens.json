{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "tab": {
    "$description": "Tabs (the suit menu's list on the left, the target's .nav): dim text on the tile, the chosen one a row fill with light text.",
    "idle": {
      "$description": "A tab: dim text on the tile; hover a row fill with light text; focus an accent ring inside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyTab",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyTabSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "disabled": {
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "selected": {
      "$description": "The chosen tab (the target's .nav .on): a row fill with light text, 9 px corners; focus an accent ring inside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyTabSelected", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 27, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "hover-pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "disabled": {
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    }
  }
}
