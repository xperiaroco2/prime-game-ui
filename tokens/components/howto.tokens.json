{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "howto": {
    "$description": "How-to card frames (the card itself is ToyPanelHowto, purple). The cards are wordless: a frame holds only its art (dist/pack/cards/*.png), no caption.",
    "frame": {
      "$description": "A how-to step frame: a mint sticker plate (the ink sketches read on it), holding one art PNG. The hard shadow is the edge form: the right and bottom outlines are 14 px (6 + 8) and reach 8 px outside the frame, as no base layer sits under a frame in the game.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoFrame", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.control}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      }
    },
    "frame-done": {
      "$description": "A done how-to step frame: the alien green sticker plate, the same edge-form hard shadow.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoFrameDone", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.green}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.control}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      }
    },
    "caption": {
      "$description": "The caption on a how-to frame: ink on the mint or green face.",
      "$deprecated": "The how-to cards are wordless (docs/ui-decisions.md): no screen draws a caption, so nothing replaces it. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoCaption", "class": "Label", "on": ["ToyHowtoFrame", "ToyHowtoFrameDone"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "note": {
      "$description": "The muted \"how to\" line of the how-to card (muted lilac on the purple panel), at t.small (spec §4.8); text.muted-on-light is t.body.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoNote", "class": "Label", "on": ["ToyPanelHowto"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    }
  }
}
