{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "howto": {
    "$description": "The how-to card's frames: tiles that hold only their art.",
    "frame": {
      "$description": "A how-to frame: a module tile with the 2 px edge and 12 px corners around its art.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoFrame", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } }
      }
    },
    "frame-done": {
      "$description": "The finish frame: the module tile with a 3 px accent outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoFrameDone", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.selected}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } }
      }
    },
    "caption": {
      "$description": "A frame caption (deprecated since ui-0.4.0: the cards are wordless).",
      "$deprecated": "The how-to cards are wordless (docs/ui-decisions.md): no screen draws a caption, so nothing replaces it. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoCaption", "class": "Label", "on": ["ToyHowtoFrame", "ToyHowtoFrameDone"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "note": {
      "$description": "The how-to card's note: dim text.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyHowtoNote", "class": "Label", "on": ["ToyPanelHowto"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    }
  }
}
