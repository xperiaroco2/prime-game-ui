{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "plate": {
    "$description": "HUD plates: mint stickers on the world with ink text (the sticker page's plates). The game's labels on a plate are the ToyPlate* Label variations below, not the dark-context text roles.",
    "default": {
      "$description": "A HUD plate: the mint sticker with a 4 px ink outline, so it reads on a white world too. The hard shadow is the edge form: the right and bottom outlines are 9 px (4 + 5) and reach 5 px outside the plate, as no base layer sits under a plate in the game.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlate", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "night": {
      "$description": "A solid plate on the deep purple ground (the loading tip): the mint sticker, as ToyPlate. The hard shadow is the edge form: the right and bottom outlines are 9 px (4 + 5) and reach 5 px outside the plate, as no base layer sits under a plate in the game.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateNight", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "alert": {
      "$description": "An alert plate: the coral sticker with the 4 px ink outline (the page's coral stickers); the ink plate text reads on it. The hard shadow is the edge form: the right and bottom outlines are 9 px (4 + 5) and reach 5 px outside the plate, as no base layer sits under a plate in the game.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateAlert", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.large}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "text": {
      "$description": "The text on a plate: ink (in place of ToyTextOnDark on a plate).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPlateText",
            "class": "Label",
            "on": ["ToyPlate", "ToyPlateNight", "ToyPlateAlert"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": { "font-color": { "$type": "color", "$value": "{color.on-accent.text}" } }
    },
    "text-muted": {
      "$description": "The dim text on a mint plate: the soft ink (in place of ToyTextMutedOnDark on a plate). Not on the coral alert plate.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPlateTextMuted",
            "class": "Label",
            "on": ["ToyPlate", "ToyPlateNight"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": { "font-color": { "$type": "color", "$value": "{color.on-accent.text-muted}" } }
    },
    "title": {
      "$description": "A title on a plate: Nunito Black in ink, no outline (a title on a bright face; in place of ToyTitleOnDark on a plate).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPlateTitle",
            "class": "Label",
            "on": ["ToyPlate", "ToyPlateNight", "ToyPlateAlert"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.title}" },
      "normal": { "font-color": { "$type": "color", "$value": "{color.on-accent.text}" } }
    },
    "timer": {
      "$description": "Numbers on a plate (the round timer): Rubik, the display role, in ink (in place of ToyTimer on a plate).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPlateTimer",
            "class": "Label",
            "on": ["ToyPlate", "ToyPlateNight", "ToyPlateAlert"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display}" },
      "normal": { "font-color": { "$type": "color", "$value": "{color.on-accent.text}" } }
    }
  }
}
