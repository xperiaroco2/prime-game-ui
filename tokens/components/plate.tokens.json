{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "plate": {
    "$description": "HUD plates (the plain tile on the world): a module fill, a 2 px edge, 12 px corners; the loud plates (the cops) are the danger colour with a deeper 8 px bottom edge. The labels on a plate are the ToyPlate* Label variations.",
    "default": {
      "$description": "A HUD tile (the target's module): the module fill #2A2540, a 2 px edge #4A4170, 12 px corners (the target's 1 px and 8 px x 1.5, the 1.5 rounded up).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlate", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }
      }
    },
    "night": {
      "$description": "A tile on the base ground (the loading tip): the plain tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateNight", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }
      }
    },
    "alert": {
      "$description": "An alarm tile: the danger face #FF5C6C, a 2 px deeper-danger edge with an 8 px bottom (the target's 5 px x 1.5).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateAlert", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{palette.danger-deep}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.alarm}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 39, "unit": "px" } }
      }
    },
    "text": {
      "$description": "Text on a tile: light #ECE8F7.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPlateText",
            "class": "Label",
            "on": ["ToyPlate", "ToyPlateNight", "ToyPlateCount", "ToyMutationCard", "ToyPlateBalance"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "text-muted": {
      "$description": "Dim text on a tile: #A39DBD.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateTextMuted", "class": "Label", "on": ["ToyPlate", "ToyPlateNight"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "title": {
      "$description": "A tile's title (a card's name, a price, the winner): light, Onest Bold at the heading size (the target's card names, 14 px x 1.5, rounded up to the heading step).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPlateTitle",
            "class": "Label",
            "on": ["ToyPlate", "ToyPlateNight", "ToyPlateNotice", "ToyMutationCard", "ToyPlateResult"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.heading-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "timer": {
      "$description": "A number on a tile (the timer, the price): light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyPlateTimer",
            "class": "Label",
            "on": ["ToyPlate", "ToyPlateNight", "ToyMutationCard", "ToyPlateBalance"]
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "notice": {
      "$description": "A notice tile (no screen since 2026-10-21): the plain tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateNotice", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 33, "unit": "px" } }
      }
    },
    "banner": {
      "$description": "The cops' minute (the target's countdown tile, loud): the danger face with its deeper 8 px bottom edge; its labels are ToyPlateAlertTitle, ToyPlateAlertText and ToyPlateAlertCountdown in the danger ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateBanner", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{palette.danger-deep}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-right": { "$type": "dimension", "$value": "{stroke.surface}" },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.alarm}" },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 45, "unit": "px" } },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 26, "unit": "px" } }
      }
    },
    "count": {
      "$description": "The dead's room countdown (the target's centre tile): the plain tile, at least 390 px wide (the target's 260 x 1.5).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateCount", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 39, "unit": "px" } }
      },
      "size": {
        "min-width": { "$type": "dimension", "$value": { "value": 390, "unit": "px" } }
      }
    },
    "head": {
      "$description": "The dead's room head: the plain tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateHead", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 39, "unit": "px" } }
      }
    },
    "goal": {
      "$description": "The role's goal on the role reveal: no plate (the target's plain line under the band), 900 px wide.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateGoal", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 39, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 900, "unit": "px" } }
      }
    },
    "result": {
      "$description": "The ends' result: no plate (the target's plain line under the band).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateResult", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 42, "unit": "px" } }
      }
    },
    "heading": {
      "$description": "A heading on a tile: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateHeading", "class": "Label", "on": ["ToyPlateNotice"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.heading-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "countdown": {
      "$description": "The dead's room countdown: light, display-large.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateCountdown", "class": "Label", "on": ["ToyPlateCount"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display-large}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "head-text": {
      "$description": "The dead's room head: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateHeadText", "class": "Label", "on": ["ToyPlateHead"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.title}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "goal-text": {
      "$description": "The goal line under the band: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateGoalText", "class": "Label", "on": ["ToyPlateGoal"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.heading}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "alert-title": {
      "$description": "The danger tile's title (КОПИ ЇДУТЬ): the danger ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateAlertTitle", "class": "Label", "on": ["ToyPlateBanner", "ToyPlateAlert"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.heading-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-danger.text}" }
      }
    },
    "alert-text": {
      "$description": "A line on the danger tile: the danger ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateAlertText", "class": "Label", "on": ["ToyPlateBanner", "ToyPlateAlert"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-danger.text}" }
      }
    },
    "alert-countdown": {
      "$description": "The cops' countdown on the danger tile: the danger ink, display-large.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyPlateAlertCountdown", "class": "Label", "on": ["ToyPlateBanner", "ToyPlateAlert"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.display-large}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-danger.text}" }
      }
    }
  }
}
