{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "setting": {
    "$description": "Settings: rows on a tile divided by the 2 px edge; the stepper's buttons are row tiles.",
    "row": {
      "$description": "A setting row (the target's .sr): no fill, a 2 px edge line under it; at least 64 px tall in the screens.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySettingRow", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-right": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": "{stroke.thin}" },
        "border-width-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "text": {
      "$description": "A setting's name: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySettingRowText", "class": "Label", "on": ["ToySettingRow"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "value": {
      "$description": "A setting's value beside its control: dim.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySettingRowValue", "class": "Label", "on": ["ToySettingRow"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "stepper": {
      "$description": "A stepper's arrow button (the target's .sb): a row tile with the 2 px edge and 9 px corners, a light chevron; hover lifts, held drops to the base; focus an accent ring outside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyStepper", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      },
      "items": {
        "$description": "The chevron icons follow the label: light, and dim when disabled.",
        "icon-normal-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-hover-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-pressed-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-hover-pressed-color": { "$type": "color", "$value": "{color.on-light.text}" },
        "icon-disabled-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "icon-focus-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    }
  }
}
