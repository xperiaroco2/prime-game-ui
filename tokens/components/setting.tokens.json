{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "setting": {
    "$description": "Setting rows and the stepper.",
    "row": {
      "$description": "A setting row on the purple panel: a borderless band of the lighter purple (no outline, no shadow).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySettingRow", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.tile}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin-top": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "content-margin-bottom": { "$type": "dimension", "$value": { "value": 9, "unit": "px" } }
      }
    },
    "text": {
      "$description": "The setting name: mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySettingRowText", "class": "Label", "on": ["ToySettingRow"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "value": {
      "$description": "The setting value: the muted lilac.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToySettingRowValue", "class": "Label", "on": ["ToySettingRow"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      }
    },
    "stepper": {
      "$description": "A small mint stepper button (minus and plus): a flat sticker, a 4 px ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyStepper", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.body-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the face lifts to a lighter shade.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-light}" }
      },
      "pressed": {
        "$description": "Held: the face darkens.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-dark}" }
      },
      "disabled": {
        "$description": "Unplugged at min, at max, or for a guest: a dulled lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a mint ring of the focus width, the focus gap outside the outline (it reads on the purple).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      },
      "items": {
        "$description": "The chevron icons follow the label: ink, and the unplugged ink when disabled.",
        "icon-normal-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-hover-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-pressed-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-hover-pressed-color": { "$type": "color", "$value": "{color.on-accent.text}" },
        "icon-disabled-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "icon-focus-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    }
  }
}
