{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "map": {
    "$description": "The map: the base board, row-tile rooms, the accent zone tint, the danger pin.",
    "board": {
      "$description": "The map board: the base with the 2 px edge and 12 px corners.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMapBoard", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.board}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.surface}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.surface}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      }
    },
    "room": {
      "$description": "A room: a row tile with the 2 px edge and 9 px corners.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMapRoom", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" },
        "content-margin": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } }
      }
    },
    "room-text": {
      "$description": "A room's name: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMapRoomText", "class": "Label", "on": ["ToyMapRoom"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "zone": {
      "$description": "A lit zone: the accent at 30 % with a 2 px accent outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMapZone", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.zone}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.medium}" }
      }
    },
    "pin": {
      "$description": "You are here: a 42 px danger pin, its top-left corner square, with a 2 px deeper danger outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyMapPin", "class": "Panel" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{palette.danger-deep}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius-top-left": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "corner-radius-top-right": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } },
        "corner-radius-bottom-right": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } },
        "corner-radius-bottom-left": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } }
      },
      "size": {
        "$type": "dimension",
        "width": { "$value": { "value": 42, "unit": "px" } },
        "height": { "$value": { "value": 42, "unit": "px" } }
      }
    }
  }
}
