{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "chip": {
    "$description": "Chips (Ink and mint, strength B): small pill stickers with a 6 px ink outline, their companion Labels, and toggle chips. A chip lies flat; only the selected toggle chip casts the hard ink shadow (the edge form).",
    "plate": {
      "$description": "A HUD chip (the role, the object under the crosshair, not ready, you are here on the map): the purple sticker, flat, as the HUD plates (the mint ToyHudCaption sits on it too).",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipPlate", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "plate-text": {
      "$description": "The text of a plate chip: mint on the purple face.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipPlateText", "class": "Label", "on": ["ToyChipPlate"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "light": {
      "$description": "The highlight chip (ready, the step to do now, an allowed task): the green sticker, flat.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLight", "class": "PanelContainer" },
          "context": "any"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.green}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "light-text": {
      "$description": "The text of a highlight chip: ink on the green face.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLightText", "class": "Label", "on": ["ToyChipLight"] },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "new": {
      "$description": "The coral \"new\" chip: the coral sticker, flat.",
      "$deprecated": "The NEW tag is gone (copy round 2): use ToyChipAlert. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipNew", "class": "PanelContainer", "replacement": "ToyChipAlert" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.coral}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "new-text": {
      "$description": "The text of a \"new\" chip.",
      "$deprecated": "Use ToyChipAlertText. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipNewText", "class": "Label", "on": ["ToyChipNew"], "replacement": "ToyChipAlertText" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "alert": {
      "$description": "The coral alert chip: marks a clash, such as a key bound twice; the coral sticker, flat.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipAlert", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "alert-text": {
      "$description": "The text of an alert chip: ink on the coral face.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipAlertText", "class": "Label", "on": ["ToyChipAlert"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "line-on-dark": {
      "$description": "An outline chip on dark: no face and no ink sticker, a mint outline on the purple.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnDark", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "line-on-dark-text": {
      "$description": "The text of an outline chip on dark: mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnDarkText", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "line-on-light": {
      "$description": "An outline chip on a panel (a banned task): no face and no ink sticker, a mint outline on the purple.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnLight", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "line-on-light-text": {
      "$description": "The text of an outline chip on a panel: mint.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnLightText", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "toggle-on-dark": {
      "$description": "An idle toggle chip on dark (language, settings sub-tabs, guide list): the mint sticker, flat.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyChipToggleOnDark",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyChipToggleOnDarkSelected" }
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.mint}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the face lifts to a lighter shade.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-light}" }
      },
      "pressed": {
        "$description": "Held: the face darkens; the chip does not move.",
        "bg-color": { "$type": "color", "$value": "{palette.mint-dark}" }
      },
      "disabled": {
        "$description": "Unplugged: a dulled lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a mint ring of the focus width, the focus gap outside the outline (it reads on the purple).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      }
    },
    "toggle-on-dark-selected": {
      "$description": "A selected toggle chip on dark: the green sticker with its hard ink shadow in the edge form (the right and bottom outlines 14 px, reaching 8 px outside the chip); the label does not move.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipToggleOnDarkSelected", "class": "Button", "parent": "ToyButton" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.green}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width-top": { "$type": "dimension", "$value": "{stroke.control}" },
        "border-width-right": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-bottom": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "border-width-left": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "expand-margin-right": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "expand-margin-bottom": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "$description": "Hover: the selected face lifts to the lighter green.",
        "bg-color": { "$type": "color", "$value": "{palette.green-light}" }
      },
      "hover-pressed": {
        "$description": "Selected and hovered (a toggle rests pressed): as hover.",
        "bg-color": { "$type": "color", "$value": "{palette.green-light}" }
      },
      "disabled": {
        "$description": "Unplugged selected chip: no shadow (a 6 px outline on every side, no expand), a dulled lilac face, its outline and label in the soft ink.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a mint ring of the focus width, the focus gap outside the outline (it reads on the purple).",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      }
    },
    "toggle-on-light": {
      "$description": "An idle toggle chip on a panel (language, settings sub-tabs, guide list): the mint sticker, flat.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyChipToggleOnLight",
            "class": "Button",
            "parent": "ToyButton",
