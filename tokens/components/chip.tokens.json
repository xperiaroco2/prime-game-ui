{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "chip": {
    "$description": "Chips: static pills with their companion Labels, and toggle chips.",
    "plate": {
      "$description": "A HUD chip on a dark world: the translucent plate.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipPlate", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "plate-text": {
      "$description": "The text of a plate chip.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipPlateText", "class": "Label", "on": ["ToyChipPlate"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "light": {
      "$description": "A yellow chip with an ink outline.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLight", "class": "PanelContainer" },
          "context": "any"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.yellow}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "light-text": {
      "$description": "The text of a yellow chip.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLightText", "class": "Label", "on": ["ToyChipLight"] },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "new": {
      "$description": "The coral \"new\" chip.",
      "$deprecated": "The NEW tag is gone (copy round 2): use ToyChipAlert. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipNew", "class": "PanelContainer", "replacement": "ToyChipAlert" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.coral}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "new-text": {
      "$description": "The text of a \"new\" chip.",
      "$deprecated": "Use ToyChipAlertText. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipNewText", "class": "Label", "on": ["ToyChipNew"], "replacement": "ToyChipAlertText" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "alert": {
      "$description": "The coral alert chip: marks a clash, such as a key bound twice.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipAlert", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "alert-text": {
      "$description": "The text of an alert chip.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipAlertText", "class": "Label", "on": ["ToyChipAlert"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "line-on-dark": {
      "$description": "An outline chip on dark.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnDark", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "line-on-dark-text": {
      "$description": "The text of an outline chip on dark.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnDarkText", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "line-on-light": {
      "$description": "An outline chip on light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnLight", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    },
    "line-on-light-text": {
      "$description": "The text of an outline chip on light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnLightText", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "toggle-on-dark": {
      "$description": "An idle toggle chip on dark (language, settings sub-tabs, guide list): an outline on no fill.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyChipToggleOnDark",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyChipToggleOnDarkSelected" }
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      },
      "hover": {
        "$description": "Hover fill.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-dark}" }
      },
      "pressed": {
        "$description": "Held: as hover.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-dark}" }
      },
      "disabled": {
        "$description": "Unplugged: a muted outline and label on no fill.",
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink-on-dark}" }
      },
      "focus": {
        "$description": "Outer focus: a ring of the focus width, the focus gap outside the outline.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "toggle-on-dark-selected": {
      "$description": "A selected toggle chip on dark: yellow face, ink outline, bold label.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipToggleOnDarkSelected", "class": "Button", "parent": "ToyButton" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.yellow}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "disabled": {
        "$description": "Unplugged selected chip: pale and quiet.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a ring of the focus width, the focus gap outside the outline.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-dark.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "toggle-on-light": {
      "$description": "An idle toggle chip on light (language, settings sub-tabs, guide list): an outline on no fill.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyChipToggleOnLight",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyChipToggleOnLightSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "hover": {
        "$description": "Hover fill.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "pressed": {
        "$description": "Held: as hover.",
        "bg-color": { "$type": "color", "$value": "{color.state.hover-on-light}" }
      },
      "disabled": {
        "$description": "Unplugged: a muted outline and label on no fill.",
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a ring of the focus width, the focus gap outside the outline.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    },
    "toggle-on-light-selected": {
      "$description": "A selected toggle chip on light: yellow face, ink outline, bold label.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipToggleOnLightSelected", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.yellow}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "disabled": {
        "$description": "Unplugged selected chip: pale and quiet.",
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-ink}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "$description": "Outer focus: a ring of the focus width, the focus gap outside the outline.",
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.on-light.line}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.pill}" },
        "expand-margin": { "$type": "dimension", "$value": { "value": 5, "unit": "px" } }
      }
    }
  }
}
