{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "chip": {
    "$description": "Chips and tags of the plain tile: small faces with 6 px corners (the target's tags), a 2 px edge or outline, the label inside.",
    "plate": {
      "$description": "A HUD chip (spawn protection): a module tile with the 2 px edge and 6 px corners.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipPlate", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.surface.plate}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "plate-text": {
      "$description": "The HUD chip's text: light.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipPlateText", "class": "Label", "on": ["ToyChipPlate"] },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "light": {
      "$description": "A bright chip: the accent face.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLight", "class": "PanelContainer" },
          "context": "any"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "light-text": {
      "$description": "The bright chip's text: the accent ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLightText", "class": "Label", "on": ["ToyChipLight"] },
          "context": "any"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      }
    },
    "new": {
      "$description": "The retired NEW tag (deprecated since ui-0.2.0).",
      "$deprecated": "The NEW tag is gone (copy round 2): use ToyChipAlert. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipNew", "class": "PanelContainer", "replacement": "ToyChipAlert" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "new-text": {
      "$description": "The retired NEW tag's text (deprecated since ui-0.2.0).",
      "$deprecated": "Use ToyChipAlertText. Removed at the next major release.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipNewText", "class": "Label", "on": ["ToyChipNew"], "replacement": "ToyChipAlertText" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-danger.text}" }
      }
    },
    "alert": {
      "$description": "An alert tag (a key clash): the danger face with the danger ink, 6 px corners.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipAlert", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-color": { "$type": "color", "$value": "{color.status.alert}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "alert-text": {
      "$description": "The alert tag's text: the danger ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipAlertText", "class": "Label", "on": ["ToyChipAlert"] },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.caption-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-danger.text}" }
      }
    },
    "line-on-dark": {
      "$description": "A line chip on the ground: no fill, the 2 px edge.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnDark", "class": "PanelContainer" },
          "context": "dark"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "line-on-dark-text": {
      "$description": "The line chip's text on the ground.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnDarkText", "class": "Label" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-dark.text}" }
      }
    },
    "line-on-light": {
      "$description": "A line chip in a tile: no fill, the 2 px edge.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnLight", "class": "PanelContainer" },
          "context": "light"
        }
      },
      "panel": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.small}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      }
    },
    "line-on-light-text": {
      "$description": "The line chip's text in a tile.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipLineOnLightText", "class": "Label" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      }
    },
    "toggle-on-dark": {
      "$description": "A segment of a choice (the target's segmented control): a row face with the 2 px edge and dim text, 9 px corners; hover lifts with light text; focus an accent ring outside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyChipToggleOnDark",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyChipToggleOnDarkSelected" }
          },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      }
    },
    "toggle-on-dark-selected": {
      "$description": "The chosen segment: the accent face and outline with the accent ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipToggleOnDarkSelected", "class": "Button", "parent": "ToyButton" },
          "context": "dark"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.accent-light}" }
      },
      "hover-pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.accent-light}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      }
    },
    "toggle-on-light": {
      "$description": "A segment of a choice (the target's segmented control): a row face with the 2 px edge and dim text, 9 px corners; hover lifts with light text; focus an accent ring outside.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": {
            "variation": "ToyChipToggleOnLight",
            "class": "Button",
            "parent": "ToyButton",
            "toggle": { "selected": "ToyChipToggleOnLightSelected" }
          },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.row}" },
        "border-color": { "$type": "color", "$value": "{color.outline}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-light.text-muted}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.row-light}" },
        "font-color": { "$type": "color", "$value": "{color.on-light.text}" }
      },
      "pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.base}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      }
    },
    "toggle-on-light-selected": {
      "$description": "The chosen segment: the accent face and outline with the accent ink.",
      "$extensions": {
        "io.github.xperiaroco2.prime-game": {
          "godot": { "variation": "ToyChipToggleOnLightSelected", "class": "Button", "parent": "ToyButton" },
          "context": "light"
        }
      },
      "label": { "$type": "typography", "$value": "{type.small-bold}" },
      "normal": {
        "bg-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-color": { "$type": "color", "$value": "{palette.accent}" },
        "border-width": { "$type": "dimension", "$value": "{stroke.control}" },
        "corner-radius": { "$type": "dimension", "$value": "{radius.control}" },
        "content-margin-block": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "content-margin-inline": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "font-color": { "$type": "color", "$value": "{color.on-accent.text}" }
      },
      "hover": {
        "bg-color": { "$type": "color", "$value": "{palette.accent-light}" }
      },
      "hover-pressed": {
        "bg-color": { "$type": "color", "$value": "{palette.accent-light}" }
      },
      "disabled": {
        "bg-color": { "$type": "color", "$value": "{color.state.disabled-face}" },
        "border-color": { "$type": "color", "$value": "{color.state.disabled-edge}" },
        "font-color": { "$type": "color", "$value": "{color.state.disabled-ink}" }
      },
      "focus": {
        "bg-color": { "$type": "color", "$value": "{palette.clear}" },
        "border-color": { "$type": "color", "$value": "{color.focus}" },
        "border-width": { "$type": "dimension", "$value": "{focus.width}" },
        "corner-radius": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "expand-margin": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
      }
    }
  }
}
