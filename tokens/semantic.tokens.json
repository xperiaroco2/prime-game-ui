{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "on-dark": {
      "$description": "Text and lines on the ground: the base, the backdrops over the world and the HUD tiles.",
      "text": { "$value": "{palette.text}" },
      "text-muted": { "$value": "{palette.dim}" },
      "title": { "$value": "{palette.text}" },
      "line": { "$value": "{palette.accent}" },
      "base": { "$description": "The hard shadow until ui-1.4.0; clear since ui-2.0.0 (the plain tile has none).", "$value": "{palette.clear}" }
    },
    "on-light": {
      "$description": "Text and lines inside a tile (the name kept from Toy): on a panel, a card, the map board, a row. Since ui-2.0.0 every surface is dark, so it reads as on-dark.",
      "text": { "$value": "{palette.text}" },
      "text-muted": { "$value": "{palette.dim}" },
      "title": { "$value": "{palette.text}" },
      "line": { "$value": "{palette.accent}" },
      "base": { "$description": "The hard shadow until ui-1.4.0; clear since ui-2.0.0.", "$value": "{palette.clear}" }
    },
    "on-accent": {
      "$description": "Text on an accent face (the main action, the chosen segment, the aliens' band).",
      "text": { "$value": "{palette.accent-ink}" },
      "text-muted": { "$value": "{palette.accent-ink}" }
    },
    "on-danger": {
      "$description": "Text on a danger face (the cops, a danger button, the humans' band, the cops' end).",
      "text": { "$value": "{palette.danger-ink}" }
    },
    "outline": { "$description": "Every tile's and control's 2 px edge (the name kept: it was the ink outline).", "$value": "{palette.edge}" },
    "focus": { "$description": "The focus ring.", "$value": "{palette.accent}" },
    "surface": {
      "night": { "$description": "The full-screen base ground.", "$value": "{palette.base}" },
      "full-screen": { "$description": "The ground of the loud full screens (the role reveal, the ends) under their band.", "$value": "{palette.base}" },
      "night-plate": { "$description": "A tile on the base ground (the loading tip).", "$value": "{palette.module}" },
      "plate": { "$description": "A HUD tile: the module (the dark context's labels sit on it).", "$value": "{palette.module}" },
      "backdrop": { "$value": "{palette.backdrop}" },
      "backdrop-deep": { "$value": "{palette.backdrop-deep}" },
      "panel": { "$description": "A panel: the module, its text light.", "$value": "{palette.module}" },
      "board": { "$description": "The map board inside a panel: the base.", "$value": "{palette.base}" },
      "tile": { "$description": "A row face on a tile.", "$value": "{palette.row}" },
      "field": { "$description": "A field's cell: the base.", "$value": "{palette.base}" },
      "drop": { "$description": "The hard shadow under panels until ui-1.4.0; clear since ui-2.0.0.", "$value": "{palette.clear}" }
    },
    "status": {
      "stamina": { "$description": "Stamina pips: the light text colour (the target's second pip colour).", "$value": "{palette.text}" },
      "health-full": { "$value": "{palette.accent}" },
      "health-empty": { "$value": "{palette.danger}" },
      "progress": { "$value": "{palette.accent}" },
      "alert": { "$value": "{palette.danger}" },
      "calm": { "$description": "The anger meter's fill while calm.", "$value": "{palette.dim}" },
      "track": { "$description": "The empty part of a bar and an empty pip.", "$value": "{palette.base}" }
    },
    "state": {
      "$description": "State colours (the target page shows normal and unplugged; the agent derived the rest inside the palette, docs/ui-decisions.md).",
      "disabled-face": { "$value": "{palette.row}" },
      "disabled-ink": { "$value": "{palette.dim}" },
      "disabled-edge": { "$description": "An unplugged face's edge (the target's .btn.no bottom edge).", "$value": "{palette.base}" },
      "disabled-ink-on-dark": { "$value": "{palette.dim}" },
      "hover-on-dark": { "$value": "{palette.row}" },
      "hover-on-light": { "$value": "{palette.row}" },
      "held-accent": { "$description": "A held accent face.", "$value": "{palette.accent-dark}" }
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Text Onest (Medium 500, Bold 700); titles, numbers, the loud titles, the logo and the kickers Unbounded Bold (the engineer, 2026-10-22: fonts Unbounded and Onest; the target page pages/suit-final).",
    "caption": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.caption}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "caption-bold": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.caption}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.small}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "small-bold": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.small}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.body}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "body-bold": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.body}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "body-large": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.body-large}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "body-large-bold": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.body-large}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.heading}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "heading-bold": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.heading}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.base}"
      }
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.logo}",
        "fontSize": "{font.size.title}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.logo}"
      },
      "$description": "A title (a panel's, a machine screen's): Unbounded Bold."
    },
    "display": {
      "$value": {
        "fontFamily": "{font.family.number}",
        "fontSize": "{font.size.display}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.number}"
      }
    },
    "display-large": {
      "$value": {
        "fontFamily": "{font.family.number}",
        "fontSize": "{font.size.display-large}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.number}"
      }
    },
    "hero": {
      "$value": {
        "fontFamily": "{font.family.logo}",
        "fontSize": "{font.size.hero}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.tight}",
        "lineHeight": "{font.line-height.logo}"
      },
      "$description": "A title on its own tile (pre and post game): Unbounded Bold at the hero size."
    },
    "hero-display": {
      "$description": "The loud titles on a band (the role reveal, the ends; the engineer, 2026-10-22): Unbounded Bold at the hero size 126 (the target's 84 px x 1.5).",
      "$value": {
        "fontFamily": "{font.family.logo}",
        "fontSize": "{font.size.hero}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.tight}",
        "lineHeight": "{font.line-height.logo}"
      }
    },
    "logo": {
      "$value": {
        "fontFamily": "{font.family.logo}",
        "fontSize": "{font.size.display-large}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.none}",
        "lineHeight": "{font.line-height.logo}"
      }
    },
    "kicker": {
      "$description": "A tile's kicker and a tag (the target's .tab and .tg): Unbounded Bold capitals, 2 px apart, at the kicker size.",
      "$value": {
        "fontFamily": "{font.family.logo}",
        "fontSize": "{font.size.kicker}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.wide}",
        "lineHeight": "{font.line-height.logo}"
      }
    }
  },
  "motion": {
    "$type": "transition",
    "press": { "$value": { "duration": "{duration.press}", "delay": "{duration.none}", "timingFunction": "{ease.press}" } }
  }
}
