{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "font": {
    "size": {
      "$type": "dimension",
      "$description": "Large text: x1.25 rounded half up below 48 px (display 36 is 45, kicker 14 is 18); 48 px and up is already large and stays.",
      "caption": { "$value": { "value": 23, "unit": "px" } },
      "small": { "$value": { "value": 25, "unit": "px" } },
      "body": { "$value": { "value": 28, "unit": "px" } },
      "body-large": { "$value": { "value": 30, "unit": "px" } },
      "heading": { "$value": { "value": 35, "unit": "px" } },
      "title": { "$value": { "value": 45, "unit": "px" } },
      "display": { "$value": { "value": 45, "unit": "px" } },
      "display-large": { "$value": { "value": 78, "unit": "px" } },
      "hero": { "$value": { "value": 126, "unit": "px" } },
      "kicker": { "$value": { "value": 18, "unit": "px" } },
      "theme-default": { "$description": "Large text: 27 x 1.25 = 33.75, rounded to 34 by the same rule (prime-game-ui#52).", "$value": { "value": 34, "unit": "px" } }
    }
  },
  "size": {
    "$type": "dimension",
    "keycap": {
      "$description": "Large text: the keycap's height (5 + the 37 px line of 28 px Onest + 8), so a single-letter keycap stays square.",
      "$value": { "value": 50, "unit": "px" }
    }
  }
}
