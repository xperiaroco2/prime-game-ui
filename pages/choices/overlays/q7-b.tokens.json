{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Held buttons sink the whole base: 6 px primary, 5 px secondary and danger (this changes rule P49, which keeps 1 px).",
  "button": {
    "primary": {
      "press": {
        "$type": "dimension",
        "held": {
          "$value": {
            "value": 6,
            "unit": "px"
          }
        }
      }
    },
    "secondary": {
      "press": {
        "$type": "dimension",
        "held": {
          "$value": {
            "value": 5,
            "unit": "px"
          }
        }
      }
    },
    "danger": {
      "press": {
        "$type": "dimension",
        "held": {
          "$value": {
            "value": 5,
            "unit": "px"
          }
        }
      }
    }
  }
}
