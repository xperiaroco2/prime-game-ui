{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Large text x1.15, rounded half up, 18 to 36 px; 48, 64 and 96 stay.",
  "$extensions": {
    "io.github.xperiaroco2.prime-game": {
      "overlay": {
        "contexts": {
          "textSize": "large"
        }
      }
    }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "caption": {
        "$value": {
          "value": 21,
          "unit": "px"
        }
      },
      "small": {
        "$value": {
          "value": 23,
          "unit": "px"
        }
      },
      "body": {
        "$value": {
          "value": 25,
          "unit": "px"
        }
      },
      "body-large": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "heading": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 41,
          "unit": "px"
        }
      }
    }
  }
}
