{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Focus as an outer ring: focus.width at focus.gap outside the outline, a pill (P48 outer). Yellow on dark and on the controls used in both contexts (the any-context buttons, the field and the dropdown), ink on light.",
  "button": {
    "primary": {
      "focus": {
        "border-color": {
          "$type": "color",
          "$value": "{palette.yellow}"
        },
        "corner-radius": {
          "$type": "dimension",
          "$value": "{radius.pill}"
        },
        "expand-margin": {
          "$type": "dimension",
          "$value": {
            "value": 5,
            "unit": "px"
          }
        }
      }
    },
    "secondary": {
