{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A lighter lilac: OKLab lightness raised from #d8cce3 in 0.002 steps until lilac on the 70 % backdrop over a white wall reaches 4.5:1. The backdrop stays at the old 70 %, as offered.",
  "palette": {
    "$type": "color",
    "lilac": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.902,
          0.8549,
          0.9451
        ],
        "hex": "#e6daf1"
      }
    },
    "backdrop": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.149,
          0.1098,
          0.1882
        ],
        "alpha": 0.7,
        "hex": "#261c30"
      }
    }
  }
}
