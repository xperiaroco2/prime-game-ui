            { "name": "Title", "type": "Label", "variation": "ToyPlateTitle", "key": "tutorial.step.pick_up.title", "per_state": { "step-keys": { "key": "tutorial.step.move.title" }, "step-howto": { "key": "tutorial.step.howto.title" }, "step-dead": { "key": "tutorial.step.dead_room.title" } } },
