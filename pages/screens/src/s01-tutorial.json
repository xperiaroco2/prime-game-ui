              "children": [
                { "name": "Start", "type": "Button", "variation": "ToyButtonPrimary", "key": "tutorial.invite.start", "note": "Takes focus on open with the ring hidden: grab_focus(true) (Control.grab_focus's hide_focus, Godot 4.5+; unconfirmed for 4.7.2), so Enter or the gamepad's A starts at once and the ring shows only after an arrow or d-pad press. Starts lesson 1 and hides the invite for good." },
                { "name": "Skip", "type": "Button", "variation": "ToyButtonGhostOnLight", "key": "tutorial.invite.skip", "note": "Closes the invite for good; the player stays in the ship, where the game booted. Esc (ui_cancel) does the same." }
