{
  "id": "s8",
  "wireframe": "s8",
  "title": "Map and tasks",
  "background": "room-light",
  "note": "M opens and closes this screen over the running round (press, not hold; rebindable, #211); Tab does nothing here. The mouse is freed while it is open and the player keeps walking: only the mouse look stops. Nothing here is a HUD hint: the map never shows players, items, roles, teammates, delivery circles or done points. Input while it is open: the gameplay actions keep working (move, sprint, jump, interact, talk), so Space, which jumps, must never press a focused «?»: remove Space from ui_accept in the project InputMap (Enter and the gamepad's A still press; jump keeps Space), and when the card was opened with the mouse, closing it releases focus instead of giving it back to the «?». The map's focus moves only with the arrows and the d-pad; the left stick and WASD walk.",
  "states": [
    { "id": "list", "label": "Задачі", "note": "The task list beside the map; nothing hovered." },
    { "id": "zone", "label": "Наведено на задачу", "note": "Delivery's «?» has keyboard focus (the mouse over the Delivery row does the same, with no look of its own): the map lights that task's zones, for Delivery only the storage room; the zone is drawn inside the room, under its pictogram and name." },
    { "id": "guide", "label": "Натиснуто «?»", "note": "The Delivery «?» was pressed: its how-to card opens over the map; Close, Esc or M closes it." }
  ],
  "nodes": [
    {
      "name": "Dim", "type": "Panel", "variation": "ToyBackdropDeep", "anchors_preset": "full_rect",
      "note": "mouse_filter IGNORE. The round keeps running behind it."
    },
    {
      "name": "Tasks", "type": "PanelContainer", "variation": "ToyPanelMenu",
      "offset_left": 80, "offset_top": 88, "offset_right": 688, "offset_bottom": 88,
      "note": "Grows down from its top to its content (the rows, then the time). On open no control has focus (state list); the first ui_down or ui_up gives focus to the first row's «?» (Rows/Delivery/H/Help), which lights that task's zones (state zone). While the how-to card is open, focus_behavior_recursive = FOCUS_BEHAVIOR_DISABLED here (see Dim2).",
      "children": [
        {
          "name": "V", "type": "VBoxContainer", "variation": "ToyColumnTwentyFour",
          "children": [
            { "name": "Title", "type": "Label", "variation": "ToyTitleOnLight", "key": "map.tasks" },
            {
              "name": "Rows", "type": "VBoxContainer", "variation": "ToyColumnEight",
              "note": "One row per task type of the round, in the round's task order (content data). A counter only, never a description.",
              "children": [
                {
                  "name": "Delivery", "type": "PanelContainer", "variation": "ToySettingRow", "custom_minimum_size": [0, 64],
                  "note": "mouse_entered and mouse_exited (and focus on its «?») show and hide this task's zones on the board (ZoneDelivery, ZoneDeliveryTag).",
                  "children": [
                    {
                      "name": "H", "type": "HBoxContainer", "variation": "ToyRowTwelve",
                      "children": [
                        { "name": "Name", "type": "Label", "variation": "ToySettingRowValue", "key": "task.delivery", "size_flags_horizontal": "expand_fill", "size_flags_vertical": "shrink_center" },
                        {
                          "name": "Count", "type": "Label", "variation": "ToySettingRowText", "key": "map.progress", "args": { "count": "3", "total": "6" },
                          "size_flags_vertical": "shrink_center",
                          "note": "Packages delivered of the round's total; updates live while the map is open."
                        },
                        {
                          "name": "Help", "type": "Button", "variation": "ToyKeyRoundButton", "text": "?", "custom_minimum_size": [42, 42], "size_flags_vertical": "shrink_center",
                          "per_state": { "zone": { "state": "focus" } },
                          "note": "The text ? is a glyph, not a deck key (auto_translate_mode DISABLED); focus_mode ALL. 42 x 42 so it stays round at large text, where the glyph makes it 42 tall. A press opens this task's how-to card (Guide); keyboard focus shows the task's zones as hovering the row does. Every ? looks the same (no seen or new mark)."
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Switches", "type": "PanelContainer", "variation": "ToySettingRow", "custom_minimum_size": [0, 64],
                  "note": "Its zones use map.zone_hint.switches and the level's switch areas.",
                  "children": [
                    {
                      "name": "H", "type": "HBoxContainer", "variation": "ToyRowTwelve",
                      "children": [
                        { "name": "Name", "type": "Label", "variation": "ToySettingRowValue", "key": "task.switches", "size_flags_horizontal": "expand_fill", "size_flags_vertical": "shrink_center" },
                        {
                          "name": "Count", "type": "Label", "variation": "ToySettingRowText", "key": "map.progress", "args": { "count": "0", "total": "3" },
                          "size_flags_vertical": "shrink_center"
                        },
                        { "name": "Help", "type": "Button", "variation": "ToyKeyRoundButton", "text": "?", "custom_minimum_size": [42, 42], "size_flags_vertical": "shrink_center", "note": "As Delivery's Help." }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "name": "Time", "type": "Label", "variation": "ToyTextMutedOnLight", "key": "map.time", "args": { "time": "7:22" },
              "note": "The round's time left, m:ss, updated every second."
            }
          ]
        }
      ]
    },
