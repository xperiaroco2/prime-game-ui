{
  "id": "s8",
  "wireframe": "s8",
  "title": "Map and tasks",
  "background": "room-light",
  "note": "M opens and closes this screen over the running round (press, not hold; rebindable, #211); Tab does nothing here. The mouse is freed while it is open and the player keeps walking: only the mouse look stops. Nothing here is a HUD hint: the map never shows players, items, roles, teammates, delivery circles or done points.",
  "states": [
    { "id": "list", "label": "Задачі", "note": "The task list beside the map; nothing hovered." },
    { "id": "zone", "label": "Наведено на задачу", "note": "The mouse is over the Delivery row (or its «?» has keyboard focus): the map lights that task's zones, for Delivery only the storage room." },
    { "id": "guide", "label": "Натиснуто «?»", "note": "The Delivery «?» was pressed: its how-to card opens over the map; Close, Esc or M closes it." }
  ],
  "nodes": [
    {
      "name": "Dim", "type": "Panel", "variation": "ToyBackdropDeep", "anchors_preset": "full_rect",
      "note": "mouse_filter IGNORE. The round keeps running behind it."
    },
    {
      "name": "Tasks", "type": "PanelContainer", "variation": "ToyPanelMenu",
      "offset_left": 77, "offset_top": 86, "offset_right": 691, "offset_bottom": 993,
      "children": [
        {
          "name": "V", "type": "VBoxContainer", "variation": "ToyColumnTwentyFour",
          "children": [
            { "name": "Title", "type": "Label", "variation": "ToyTitleOnLight", "key": "map.tasks" },
            {
              "name": "Rows", "type": "VBoxContainer", "variation": "ToyColumnTwelve",
              "note": "One row per task type of the round, in the round's task order (content data). A counter only, never a description.",
              "children": [
                {
                  "name": "Delivery", "type": "PanelContainer", "variation": "ToySettingRow",
                  "note": "mouse_entered and mouse_exited (and focus on its «?») show and hide this task's zones on the board (ZoneDelivery, ZoneDeliveryTag).",
                  "children": [
                    {
                      "name": "H", "type": "HBoxContainer", "variation": "ToyRowTwelve",
                      "children": [
                        { "name": "Name", "type": "Label", "variation": "ToySettingRowValue", "key": "task.delivery", "size_flags_horizontal": "expand_fill", "size_flags_vertical": "shrink_center" },
                        {
                          "name": "Count", "type": "Label", "variation": "ToySettingRowText", "key": "map.progress", "args": { "count": "3", "total": "6" },
                          "size_flags_vertical": "shrink_center",
                          "note": "Packages delivered of the round's total; updates live while the map is open."
                        },
                        {
                          "name": "Help", "type": "PanelContainer", "variation": "ToyKeyRound", "custom_minimum_size": [36, 36], "size_flags_vertical": "shrink_center",
                          "note": "Build as a Button(ToyKeyRoundButton) with the text ? (auto_translate_mode DISABLED, focus_mode ALL): a press opens this task's how-to card (Guide); keyboard focus shows the task's zones as hovering the row does. Every ? looks the same (no seen or new mark). The page draws the static round keycap with the tutorial's ? until the deck has the button's own key.",
                          "children": [
                            { "name": "Text", "type": "Label", "variation": "ToyKeyText", "key": "tutorial.step.howto.how", "value_of": "key", "args": { "key": "?" }, "horizontal_alignment": "center" }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Switches", "type": "PanelContainer", "variation": "ToySettingRow",
                  "note": "Its zones use map.zone_hint.switches and the level's switch areas.",
                  "children": [
                    {
                      "name": "H", "type": "HBoxContainer", "variation": "ToyRowTwelve",
                      "children": [
                        { "name": "Name", "type": "Label", "variation": "ToySettingRowValue", "key": "task.switches", "size_flags_horizontal": "expand_fill", "size_flags_vertical": "shrink_center" },
                        {
                          "name": "Count", "type": "Label", "variation": "ToySettingRowText", "key": "map.progress", "args": { "count": "0", "total": "3" },
                          "size_flags_vertical": "shrink_center"
                        },
                        {
                          "name": "Help", "type": "PanelContainer", "variation": "ToyKeyRound", "custom_minimum_size": [36, 36], "size_flags_vertical": "shrink_center",
                          "note": "As Delivery's Help.",
                          "children": [
                            { "name": "Text", "type": "Label", "variation": "ToyKeyText", "key": "tutorial.step.howto.how", "value_of": "key", "args": { "key": "?" }, "horizontal_alignment": "center" }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            { "name": "Fill", "type": "Control", "size_flags_vertical": "expand_fill" },
            {
              "name": "Time", "type": "Label", "variation": "ToyTextMutedOnLight", "key": "map.time", "args": { "time": "7:22" },
              "note": "The round's time left, m:ss, updated every second."
            }
          ]
        }
      ]
    },
