      "name": "Downed", "type": "PanelContainer", "variation": "ToyPlate", "states": ["down", "down-holding", "raise"], "anchors_preset": "center_top", "offset_top": 228, "offset_bottom": 228, "grow_horizontal": "both", "custom_minimum_size": [900, 0], "note": "Shown from the moment the player is downed until they are raised, give up or bleed out. Never shows who knocked the player down. 228 px down (the old 152 x 1.5); 900 wide, the old 688 x 1.5 capped at the goal plate's width.",
