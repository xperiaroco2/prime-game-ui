            { "name": "Bleed", "type": "ProgressBar", "variation": "ToyBarReturnCalm", "show_percentage": false, "max_value": 1, "value": 0.7, "custom_minimum_size": [810, 24], "states": ["down", "down-holding"], "note": "One ProgressBar, ToyBarReturnCalm (the base track, the accent fill), since the health bars are pips now (ui-2.0.0) and the time left is a countdown as the dead's room return. value = bleed-out time left / bleed-out duration, falling to 0. Under 0.3 (health's alarm line) the game sets ToyBarReturnAlarm (the danger fill); no pulse (agent, open to the engineer's veto)." },
            { "name": "Left", "type": "Label", "variation": "ToyPlateTextMuted", "key": "downed.time_left", "args": { "time": "0:10" }, "horizontal_alignment": "center", "states": ["down", "down-holding"], "note": "{time} is the bleed-out time left as m:ss, updated every second." },
            { "name": "Raise", "type": "ProgressBar", "variation": "ToyBarProgress", "show_percentage": false, "max_value": 1, "value": 0.6, "custom_minimum_size": [810, 24], "states": ["raise"], "note": "The raise progress (0 to 1) while someone holds raise; if they stop, the bleed-out bar and the time return." },
            { "name": "Pad", "type": "Control", "custom_minimum_size": [0, 6], "states": ["raise"], "note": "An empty spacer: a bar that ends a plate gets 6 px more room under it than the plate's padding." }
          ]
