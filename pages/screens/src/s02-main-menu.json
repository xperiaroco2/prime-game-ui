{
  "id": "s2",
  "wireframe": "s2",
  "title": "Main menu",
  "background": "menu",
  "note": "The live lobby stays behind a dim backdrop with an idle camera. There is no server browser: Host makes a game with a code, Join takes a code, Join by address (Direct) joins or hosts directly. Join, Direct and Settings are one ButtonGroup with allow_unpress: pressing one opens its panel to the right of the items (Join's and Direct's top on Host's top; Settings' a taller root of its own); pressing it again, Back or Esc (ui_cancel) closes it. The panels have no title: the pressed item names the open panel.",
  "states": [
    { "id": "main", "label": "Меню", "note": "The menu alone; keyboard focus starts on Host." },
    { "id": "code", "label": "Код", "note": "Join pressed: the code panel opens with the field focused and empty, Join unplugged." },
    { "id": "code-ready", "label": "Код готовий", "note": "Six valid characters typed: Join is enabled." },
    { "id": "direct", "label": "За адресою", "note": "Join by address pressed: the Direct panel, the address focused." },
    { "id": "settings", "label": "Налаштування", "note": "Settings pressed: the Settings panel on its Sound and voice page, focus on Sound and voice." }
  ],
  "nodes": [
    { "name": "Backdrop", "type": "Panel", "variation": "ToyBackdrop", "anchors_preset": "full_rect", "note": "mouse_filter IGNORE; it dims the live lobby behind the menu." },
    {
      "name": "Column", "type": "VBoxContainer", "variation": "ToyColumnThirtyTwo", "anchors_preset": "top_left", "offset_left": 84, "offset_top": 66, "offset_right": 84, "offset_bottom": 66, "note": "The menu column at the sticker sketch's place (pages/sticker: left 56, top 44, 400 wide, x 1.5).",
      "children": [
        { "name": "Logo", "type": "Label", "variation": "ToyLogo", "text": "prime-game", "note": "The game's name, the working title \"prime-game\" (auto_translate_mode DISABLED; not a deck key). The title is open (m8 §1: \"My Alien Prime Friends\" is a working title; a decision comes before any public store page)." },
        {
          "name": "NameRow", "type": "HBoxContainer", "variation": "ToyRowSixteen", "size_flags_horizontal": "shrink_begin", "custom_minimum_size": [600, 0],
          "children": [
            { "name": "NameLabel", "type": "Label", "variation": "ToyTextMutedOnDark", "key": "player.name", "size_flags_vertical": "shrink_center" },
            { "name": "Name", "type": "LineEdit", "variation": "ToyField", "text": { "uk": "Олена", "en": "Olena" }, "size_flags_horizontal": "expand_fill", "note": "The player's name, kept between sessions (user://); never empty: the last name used, else the system user name. max_length 16 (characters, the same limit in both languages: wave 1's proposal until the game sets its name rule; the host checks String.length() too); a longer text scrolls inside the field. auto_translate_mode DISABLED." }
          ]
        },
        {
          "name": "Body", "type": "HBoxContainer", "variation": "ToyRowThirtyTwo", "note": "The items, then the open panel (if any) to their right, its top on Host's top.",
          "children": [
            {
              "name": "Items", "type": "VBoxContainer", "variation": "ToyColumnSixteen", "custom_minimum_size": [600, 0], "size_flags_vertical": "shrink_begin", "note": "Up and down move the focus through the items; the focused, hovered or pressed item shows its pointer icon.",
              "children": [
                { "name": "Host", "type": "Button", "variation": "ToyMenuItem", "key": "menu.host", "icon": "pointer", "icon_size": 36, "alignment": "left", "state": "focus", "per_state": { "code": { "state": "normal" }, "code-ready": { "state": "normal" }, "direct": { "state": "normal" }, "settings": { "state": "normal" } }, "note": "Focus on open. Hosts a game with a code (WebRTC) and goes straight to the lobby (s4); a failure shows s3 host-failed." },
                { "name": "Join", "type": "Button", "variation": "ToyMenuItem", "key": "menu.join", "icon": "pointer", "icon_size": 36, "alignment": "left", "toggle_mode": true, "per_state": { "code": { "state": "selected" }, "code-ready": { "state": "selected" } }, "note": "In the menu ButtonGroup; button_pressed while CodePanel is open (ToyMenuItem's own pressed StyleBox and pointer). Toggles CodePanel." },
                { "name": "Direct", "type": "Button", "variation": "ToyMenuItem", "key": "menu.direct", "icon": "pointer", "icon_size": 36, "alignment": "left", "toggle_mode": true, "per_state": { "direct": { "state": "selected" } }, "note": "In the menu ButtonGroup; button_pressed while DirectPanel is open (its own pressed StyleBox). Toggles DirectPanel." },
                { "name": "Tutorial", "type": "Button", "variation": "ToyMenuItem", "key": "menu.tutorial", "icon": "pointer", "icon_size": 36, "alignment": "left", "note": "Loads the tutorial's first lesson (s1)." },
                { "name": "Settings", "type": "Button", "variation": "ToyMenuItem", "key": "menu.settings", "icon": "pointer", "icon_size": 36, "alignment": "left", "toggle_mode": true, "per_state": { "settings": { "state": "selected" } }, "note": "In the menu ButtonGroup; button_pressed while SettingsPanel is open (its own pressed StyleBox). Toggles SettingsPanel." },
                { "name": "Quit", "type": "Button", "variation": "ToyMenuItem", "key": "menu.quit", "icon": "pointer", "icon_size": 36, "alignment": "left", "note": "Quits the game at once." }
              ]
            },
            { "name": "Gap", "type": "Control", "custom_minimum_size": [64, 0], "states": ["code", "code-ready", "direct"], "note": "An empty spacer: 32 + 64 + 32 px between the items and the open panel. Shown with any panel." },
            {
              "name": "CodePanel", "type": "PanelContainer", "variation": "ToyPanelMenu", "states": ["code", "code-ready"], "custom_minimum_size": [784, 0], "size_flags_vertical": "shrink_begin", "note": "Join with a code. Shown while Join is pressed. As wide as DirectPanel, so the two panels never differ; 784 px holds the field and the buttons at large text.",
              "children": [
                {
                  "name": "V", "type": "VBoxContainer", "variation": "ToyColumnTwentyFour",
                  "children": [
                    {
                      "name": "Field", "type": "VBoxContainer", "variation": "ToyColumnTwelve",
                      "children": [
                        { "name": "CodeLabel", "type": "Label", "variation": "ToyTextMutedOnLight", "key": "common.code" },
                        { "name": "Code", "type": "LineEdit", "variation": "ToyField", "text": "", "state": "focus", "per_state": { "code-ready": { "text": "K7Q2XR" } }, "note": "Focused and empty when the panel opens. max_length 6; upper-cases as typed, drops spaces and dashes on paste, accepts only the 31-letter code alphabet (no 0, O, 1, I, L). Keeps what was typed after a failure (back from s3). Enter = Join when it is enabled. auto_translate_mode DISABLED." }
                      ]
                    },
                    {
                      "name": "Buttons", "type": "HBoxContainer", "variation": "ToyRowTwentyFour",
                      "children": [
                        { "name": "Join", "type": "Button", "variation": "ToyButtonPrimary", "key": "join.connect", "size_flags_horizontal": "expand_fill", "state": "disabled", "per_state": { "code-ready": { "state": "normal" } }, "note": "Disabled (unplugged) until the field holds 6 valid characters. Joins by the code: s3 finding." },
                        { "name": "Back", "type": "Button", "variation": "ToyButtonGhostOnLight", "key": "common.back", "note": "Closes the panel and unpresses Join; Esc does the same." }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "name": "DirectPanel", "type": "PanelContainer", "variation": "ToyPanelMenu", "states": ["direct"], "custom_minimum_size": [784, 0], "size_flags_vertical": "shrink_begin", "note": "Join or host directly over ENet (LAN, VPN, playit.gg). Shown while Direct is pressed. No address is shown anywhere else (streams).",
              "children": [
                {
                  "name": "V", "type": "VBoxContainer", "variation": "ToyColumnTwentyFour",
                  "children": [
                    {
                      "name": "Field", "type": "VBoxContainer", "variation": "ToyColumnTwelve",
                      "children": [
                        { "name": "AddressLabel", "type": "Label", "variation": "ToyTextMutedOnLight", "key": "join.address" },
                        { "name": "Address", "type": "LineEdit", "variation": "ToyField", "text": "192.168.0.12", "state": "focus", "note": "Focused when the panel opens. Takes host or host:port, host names included (JoinTarget). Keeps what was typed after a failure. Enter = Join. auto_translate_mode DISABLED." },
                        { "name": "Port", "type": "Label", "variation": "ToyTextMutedOnLight", "key": "join.port", "args": { "port": "7777" }, "note": "The default port, used when the address has none." }
                      ]
                    },
                    {
                      "name": "Buttons", "type": "HBoxContainer", "variation": "ToyRowTwentyFour",
                      "children": [
                        { "name": "Join", "type": "Button", "variation": "ToyButtonPrimary", "key": "join.connect", "size_flags_horizontal": "expand_fill", "note": "Disabled (unplugged) while Address is empty. Joins over ENet: s3 (the connecting steps, no code row)." },
                        { "name": "Host", "type": "Button", "variation": "ToyButtonSecondary", "key": "menu.host", "note": "Hosts directly (ENet) on the port typed, else the default, and opens the lobby (s4) with no code row." },
                        { "name": "Back", "type": "Button", "variation": "ToyButtonGhostOnLight", "key": "common.back", "note": "Closes the panel and unpresses Direct; Esc does the same." }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "SettingsPanel", "type": "PanelContainer", "variation": "ToyPanelMenu", "states": ["settings"], "anchors_preset": "top_left", "offset_left": 812, "offset_top": 90, "offset_right": 1881, "offset_bottom": 990, "note": "Shown while Settings is pressed. A root of its own (too tall for Body): its left edge on the code and Direct panels' left edge (812), its right edge 39 px in (the HUD edge), 900 tall and centred vertically; raised on its ToyRaised wrapper. It holds the Esc menu's Settings scene (s5/Menu/H/Page/Settings), one scene that both menus instance (#301): the mic, the mode, the threshold with its live meter, noise suppression and the volumes work without a session; nothing is sent. Focus goes to Settings/Sub/Sound when it opens; Settings again or Esc (ui_cancel) closes it and gives the focus back to Items/Settings.",
      "children": [
        {
          "name": "Settings", "type": "VBoxContainer", "variation": "ToyColumnTwentyFour", "note": "The s5 Settings scene (s5/Menu/H/Page/Settings), instanced here on its Sound and voice page; its nodes, notes and other pages are s5's. Build it once, in s5.",
          "children": [
            {
              "name": "Sub", "type": "HBoxContainer", "variation": "ToyRowTwelve",
