                { "name": "Controls", "type": "Button", "variation": "ToyChipToggleOnLight", "key": "settings.tab.controls", "toggle_mode": true },
                { "name": "Display", "type": "Button", "variation": "ToyChipToggleOnLight", "key": "settings.tab.display", "toggle_mode": true },
