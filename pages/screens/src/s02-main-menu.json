                          "name": "H", "type": "HBoxContainer", "variation": "ToyRowSixteen",
                          "children": [
                            { "name": "Name", "type": "Label", "variation": "ToySettingRowText", "key": "settings.talk_mode", "size_flags_horizontal": "expand_fill", "size_flags_vertical": "shrink_center" },
                            { "name": "Mode", "type": "OptionButton", "variation": "ToyDropdown", "key": "settings.talk_mode.open", "items": ["settings.talk_mode.open", "settings.talk_mode.push", "common.off"], "custom_minimum_size": [450, 0], "size_flags_vertical": "shrink_center" }
                          ]
                        }
                      ]
                    },
                    {
                      "name": "Threshold", "type": "PanelContainer", "variation": "ToySettingRow", "custom_minimum_size": [0, 96],
                      "children": [
                        {
