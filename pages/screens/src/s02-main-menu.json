      ]
    },
    { "name": "Version", "type": "Label", "variation": "ToyTextMutedOnDark", "key": "menu.version", "args": { "version": "0.4" }, "anchors_preset": "bottom_right", "offset_left": -39, "offset_top": -39, "offset_right": -39, "offset_bottom": -39, "grow_horizontal": "begin", "grow_vertical": "begin", "note": "The build's version (ProjectSettings application/config/version)." }
